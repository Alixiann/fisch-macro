  macroCallbacks.track = function(bar, fish, playerbar, now)
      local origin, size = bar.AbsolutePosition, bar.AbsoluteSize
      local fp, fs = fish.AbsolutePosition, fish.AbsoluteSize
      local bp, bs = playerbar.AbsolutePosition, playerbar.AbsoluteSize
      if not (origin and size and fp and fs and bp and bs)
          or size.X <= 0 then
          mouse(false)
          resetTracking()
          return false
      end
      local f = (fp.X + fs.X / 2 - origin.X) / size.X
      local b = (bp.X + bs.X / 2 - origin.X) / size.X
      local width = bs.X / size.X
      if f ~= f or b ~= b or width <= 0
          or math.abs(f) > 5 or math.abs(b) > 5 then
          mouse(false)
          resetTracking()
          return false
      end
      local dt = lastTime and now - lastTime or 0
      if dt > 0 and dt < 0.2 then
          local rawFish = math.clamp((f - lastFish) / dt, -3, 3)
          local rawBar = math.clamp((b - lastBar) / dt, -3, 3)
          local fa = 1 - math.exp(-dt / 0.035)
          local ba = 1 - math.exp(-dt / 0.018)
          if rawFish * fishVelocity < 0 then
              fishVelocity = 0
          end
          fishVelocity += (rawFish - fishVelocity) * fa
          barVelocity += (rawBar - barVelocity) * ba
          local speed = math.abs(fishVelocity)
          local smoothing = speed > activity and 0.04 or 0.30
          local aa = 1 - math.exp(-dt / smoothing)
          activity += (speed - activity) * aa
          if math.abs(rawFish) > 0.04 then
              fishMoving, quietTime = true, 0
          elseif math.abs(rawFish) < 0.015 then
              quietTime += dt
              if quietTime >= 0.06 then
                  fishMoving = false
                  fishVelocity = 0
              end
          else
              quietTime = 0
          end
      else
          fishVelocity, barVelocity = 0, 0
          fishMoving, quietTime = false, 0
          activity = 0
      end
      lastFish, lastBar, lastTime = f, b, now
      local fast = math.clamp((activity - 0.06) / 0.24, 0, 1)
      local target, feedForward = f, 0
      if fishMoving then
          local limit = math.min(width * 0.12, 0.025)
          local predictionTime = 0.015 + 0.030 * fast
          target = math.clamp(
              f + math.clamp(
                  fishVelocity * predictionTime,
                  -limit, limit
              ),
              0, 1
          )
          feedForward = fishVelocity
      end
      local originalGain = fishMoving and 5 or 8
      local gain = 3.5 + (originalGain - 3.5) * fast
      local errorPosition = target - b
      local tolerance = math.min(width * 0.035, 0.008) * (1 - fast)
      if math.abs(errorPosition) <= tolerance then
          errorPosition = 0
      elseif tolerance > 0 then
          if errorPosition > 0 then
              errorPosition -= tolerance
          else
              errorPosition += tolerance
          end
      end
      local wantedVelocity = math.clamp(
          feedForward + errorPosition * gain,
          -1.5, 1.5
      )
      local errorVelocity = wantedVelocity - barVelocity
      local originalThreshold = fishMoving and 0.025 or 0.012
      local threshold = 0.030 + (originalThreshold - 0.030) * fast
      local desired = held
      if errorVelocity > threshold then
          desired = true
      elseif errorVelocity < -threshold then
          desired = false
      end
      if math.abs(f - b) > width * 0.5 then
          desired = f > b
      end
      mouse(desired)
      return true
  end
  layoutTeleportMenus()
  display("OFF")
  previous[MACRO_KEY] = iskeypressed(MACRO_KEY) == true
  previous[0x9D] = iskeypressed(0x9D) == true -- Right Ctrl scan code
  previous[0xDD] = iskeypressed(0xDD) == true
  previous[0xDB] = iskeypressed(0xDB) == true
  previous[0x1A] = iskeypressed(0x1A) == true
  previous[INSTANT_KEY] = iskeypressed(INSTANT_KEY) == true
  previous[AUTO_TOTEM_KEY] = iskeypressed(AUTO_TOTEM_KEY) == true
  shown = true
  fadeAmount = 1
  fadeLastTime = tick()
  updateFade(fadeLastTime)
  refreshStats(tick())
  nextStats = tick() + 1
  task.spawn(function()
      while alive do
          if tick() >= nextEnvironment and not autoTotem.environmentBusy then
              autoTotem.environmentBusy = true
              local ok, events = pcall(readEnvironment, tick())
              autoTotem.environmentBusy = false
              if not alive then return end
              if ok then cachedEvents = events
              else warn("Environment refresh: " .. tostring(events)) end
              nextEnvironment = tick() + ENVIRONMENT_INTERVAL
          end
          task.wait(0.1)
      end
  end)
  task.spawn(function()
      while alive do
          if autoTotem.enabled then
              autoTotem.poll()
              task.wait(autoTotem.checkInterval)
          else
              task.wait(0.75)
          end
      end
  end)
  -- Keep the Auto Totem hotkey outside the macro/UI worker so an active
  -- event scan can never delay the disable command.
  task.spawn(function()
      while alive do
          local pressed = false
          if isrbxactive() then
              local typing = false
              pcall(function()
                  typing = UserInputService:GetFocusedTextBox() ~= nil
              end)
              if not typing then
                  pressed = macroCallbacks.edge(AUTO_TOTEM_KEY)
              else
                  previous[AUTO_TOTEM_KEY] = iskeypressed(AUTO_TOTEM_KEY) == true
              end
          else
              previous[AUTO_TOTEM_KEY] = iskeypressed(AUTO_TOTEM_KEY) == true
          end
          if pressed then autoTotem.toggle() end
          task.wait(autoTotem.enabled and 0.02 or 0.05)
      end
  end)
  task.spawn(function()
      local ok, err = pcall(function()
          while alive do
              local now = tick()
              local macroPrimary = macroCallbacks.edge(MACRO_KEY)
              local macroScan = macroCallbacks.edge(0x9D)
              local toggle = macroPrimary or macroScan -- Right Ctrl
              local instantToggle = macroCallbacks.edge(INSTANT_KEY) -- Right Alt
              local hide = macroCallbacks.edge(0xDD) -- ]
              local harpoonToggleVk = macroCallbacks.edge(0xDB) -- [ virtual key
              local harpoonToggleScan = macroCallbacks.edge(0x1A) -- [ scan code
              local harpoonToggle = harpoonToggleVk or harpoonToggleScan
              local focused = isrbxactive()
              local typing = false
              pcall(function()
                  typing = UserInputService:GetFocusedTextBox() ~= nil
              end)
              if typing then
                  toggle, instantToggle, harpoonToggle = false, false, false
              end
              if not focused then
                  navigationWanted = navigationOn
              end
              if not panelInputCaptured then updateKeys(now) end
              if not macroCallbacks.renderConnection then updateDrag(focused) end
              if hide then macroCallbacks.setShown(not shown) end
              if focused then
               if instantToggle then toggleInstant() end
                  if toggle then
                      toggleMacro()
                  end
              end
              if harpoonToggle and not typing then
                  requestHarpoonToggle()
               end
               updatePanelInput(focused)
              macroCallbacks.updateInstant(now, focused)
              macroCallbacks.updateBarLock(now)
               local reelMinigameActive = enabled and focused and not panelInputCaptured
                   and fishingMinigameActive()
               local autoTotemBlocking = enabled and (autoTotem.busy
                   or (autoTotem.enabled and not autoTotem.startupConfirmed))
               if not enabled or not focused or panelInputCaptured
                   or autoTotemBlocking then
                  mouse(false)
                  releaseKey()
                  releaseAt, idleSince = nil, nil
                  recoveryStage = 0
                  resetTracking()
                  if focused and not panelInputCaptured then
                      setNavigation(false)
                  end
                   display(not enabled and "OFF"
                       or autoTotem.busy and "AUTO TOTEM"
                       or autoTotemBlocking and "WAITING FOR AURORA"
                       or panelInputCaptured and "PAUSED / PANEL"
                       or "PAUSED / UNFOCUSED")
              else
      local reel = gui and (gui:FindFirstChild("reel") or gui:FindFirstChild("Reel"))
                  local bar = reel and reel:FindFirstChild("bar")
                  local fish = bar and bar:FindFirstChild("fish")
                  local playerbar = bar and bar:FindFirstChild("playerbar")
                  local button = harpoonPullEnabled and activeHarpoonPullButton()
                      or (enabled and activeShakeButton())
                  local reelActive = reelMinigameActive
                  local shakeActive = button ~= nil and not reelActive
                   if equipPending and equippedRod() then
                       equipPending = false
                       equipReadyAt = 0
                       nextEquipAttemptAt = 0
                   end
                   if equipPending then
                      mouse(false)
                      setNavigation(false)
                      display("EQUIPPING ROD")
                      if not navigationOn
                          and not navigationReleaseAt
                          and now >= navigationReadyAt
                          and now >= nextEquipAttemptAt
                          and not pendingKey then
                          if ensureFishingRod() then
                              equipPending = false
                              equipReadyAt = now + 0.40
                              nextEquipAttemptAt = now + 0.75
                              nextCast = equipReadyAt
                              releaseAt = nil
                              idleSince = nil
                          elseif tap(0x54, now) then -- T fallback
                              equipReadyAt = now + 0.40
                              nextEquipAttemptAt = now + 0.75
                              nextCast = equipReadyAt
                              releaseAt = nil
                              idleSince = nil
                          end
                      end
                  elseif now < equipReadyAt then
                      mouse(false)
                      display("EQUIPPING ROD")
                  elseif reelActive then
                      releaseKey()
                      setNavigation(false)
                      idleSince = nil
                      recoveryStage = 0
                      if not wasReeling then
                          mouse(false)
                          resetTracking()
                      end
                      wasReeling = true
                      releaseAt = nil
                      if controlBarLockEnabled then
                          mouse(false)
                          display("CONTROL BAR LOCK")
                      elseif fish and playerbar then
                          local valid = macroCallbacks.track(bar, fish, playerbar, now)
                          display(
                              not valid and "WAITING FOR REEL"
                              or fishMoving and "PREDICTING"
                              or "CENTERING"
                          )
                      else
                          mouse(false)
                          display("WAITING FOR REEL")
                      end
                  elseif shakeActive then
                      mouse(false)
                      releaseAt, idleSince = nil, nil
                      recoveryStage = 0
                      wasReeling = false
                      resetTracking()
                      if navigationOn or navigationWanted then
                          releaseKey()
                          setNavigation(false)
                      end
                      display("SHAKING")
                  else
                      if navigationOn or navigationWanted then
                          releaseKey()
                          setNavigation(false)
                      end
                      if wasReeling then
                          wasReeling = false
                          mouse(false)
                          resetTracking()
                          nextCast, idleSince = now, now
                      end
                      idleSince = idleSince or now
                      if recoveryStage == 0
                          and now - idleSince >= FAILSAFE then
                          mouse(false)
                          releaseAt = nil
                          releaseKey()
                          recoveryStage, recoveryAt = 1, now
                      end
                      if recoveryStage > 0 then
                          display("RECOVERING ROD")
                          if now >= recoveryAt and not pendingKey then
                              if recoveryStage == 1 then
                                  if tap(0x54, now) then
                                      recoveryStage = 2
                                      recoveryAt = now + 0.35
                                  end
                              elseif recoveryStage == 2 then
                                  if tap(0x54, now) then
                                      recoveryStage = 3
                                      recoveryAt = now + 0.35
                                  end
                              else
                                  recoveryStage = 0
                                  idleSince, nextCast = now, now
                              end
                          end
                      elseif releaseAt then
                          if castMode == "Instant" then
                              -- In fast mode, release on the first visible cast
                              -- meter sample instead of guessing with a timer.
                              local castPercent = castReading()
                              if castPercent ~= nil then
                                  mouse(false)
                                  releaseAt = nil
                                  nextCast = now + RETRY
                                  display("PERFECT CAST OFF")
                              elseif now - releaseAt >= CAST_TIMEOUT then
                                  mouse(false)
                                  releaseAt = nil
                                  nextCast = now + RETRY
                                  display("CAST METER UNAVAILABLE / RETRY")
                              end
                          elseif castMode == "Perfect" then
                              if now >= perfectCastNextUpdate then
                                  perfectCastNextUpdate = now + PERFECT_CAST_UPDATE
                                  perfectCastPercent, perfectCastInGreen = castReading()
                              end
                              if perfectCastInGreen then
                                  mouse(false)
                                  releaseAt = nil
                                  nextCast = now + RETRY
                                  display(string.format("CAST %.0f%% / GREEN",
                                      tonumber(perfectCastPercent) or 0))
                              elseif now - releaseAt >= CAST_TIMEOUT then
                                  mouse(false)
                                  releaseAt = nil
                                  nextCast = now + RETRY
                                  display("CAST METER UNAVAILABLE / RETRY")
                              else
                                  display(perfectCastPercent
                                      and string.format("CAST %.0f%% / 100%%",
                                          tonumber(perfectCastPercent) or 0)
                                      or "WAITING FOR CAST METER")
                              end
                          elseif now - releaseAt >= CAST_TIMEOUT then
                              mouse(false)
                              releaseAt = nil
                              nextCast = now + RETRY
                              display("CAST METER UNAVAILABLE / RETRY")
                          else
                              display("PERFECT CAST OFF")
                          end
                      elseif dragging then
                          display("MOVING PANEL")
                      elseif now >= nextCast then
                          if equippedRod() then
                              castMeter, castFill, castGreen = nil, nil, nil
                              perfectCastNextUpdate = now
                              perfectCastPercent, perfectCastInGreen = nil, false
                              mouse(true)
                              releaseAt = now -- Start of charge; not a release deadline.
                              display(castMode == "Instant"
                                  and "PERFECT CAST OFF" or "CAST 0% / 100%")
                          elseif ensureFishingRod() then
                              equipPending = false
                              equipReadyAt = now + 0.40
                              nextEquipAttemptAt = now + 0.75
                              nextCast = equipReadyAt
                              releaseAt = nil
                              idleSince = nil
                              display("EQUIPPING ROD")
                          else
                              requestRodReequip(now)
                          end
                      else
                          display("WAITING FOR BITE")
                      end
                  end
              end
              if now >= nextStats then
                  refreshStats(now)
                  nextStats = now + 1
              end
              updateDropdownAnimation(now)
              updateFade(now)
              local activeWork = enabled or autoTotem.enabled or fishEsp.enabled
                  or instantEnabled or rodSpeed.enabled or harpoonPullEnabled
                  or controlBarLockEnabled
                  or dragging or teleportWindow.dragging
              local uiAnimating = dragging or teleportWindow.dragging
                  or npcMenuOpen or autoTotem.open or totemMenu.open
                  or islandMenu.open
              -- Poll visible UI at up to 120 Hz; unchanged geometry is cached.
              -- Decorative color/fade work has its separate 60 Hz budget.
              local loopDelay = shown and 1 / 120
                  or enabled and 0.016
                  or activeWork and 0.016
                  or (shown or uiAnimating) and 0.016
                  or 0.05
              task.wait(loopDelay)
          end
      end)
      if not ok then
          macroCallbacks.stop()
          warn("Fisch Macro stopped: " .. tostring(err))
      end
  end)


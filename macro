  local barLockMethodCache, barLockFishCache, barLockReelId
  local barLockMethodLoading, barLockFishLoading = false, false
  local barLockMethodApplied = false
  local barLockFishGeneration = 0
  local barLockScanAt, barLockWriteAt = 0, 0
  local function normalIsInBar(self, fishPosition, fishWidth)
      if self.barSize <= 0 then return false end
      local halfFishWidth = (fishWidth or 0) / 2
      return self.barPosition - self.barSize / 2 - halfFishWidth
              < fishPosition
          and fishPosition < self.barPosition + self.barSize / 2
              + halfFishWidth
  end
  local function restoreBarLock()
      if barLockMethodApplied and barLockMethodCache then
          pcall(applygc, barLockMethodCache, "IsInBar", normalIsInBar)
      end
      barLockMethodApplied = false
  end
  macroCallbacks.updateBarLock = function(now)
      if not controlBarLockEnabled then
          restoreBarLock()
          return
      end
      if type(getgc) ~= "function" or type(applygc) ~= "function" then
          return
      end
      if not barLockMethodCache and not barLockMethodLoading then
          barLockMethodLoading = true
          task.spawn(function()
              local ok, cache = pcall(getgc, "IsInBar")
              barLockMethodLoading = false
              if alive and ok and type(cache) == "table" and #cache > 0 then
                  barLockMethodCache = cache
              end
          end)
      end
      if barLockMethodCache and not barLockMethodApplied then
          local ok, writes = pcall(applygc, barLockMethodCache,
              "IsInBar", function() return true end)
          barLockMethodApplied = ok and type(writes) == "number"
              and writes > 0
      end
      if not barLockMethodApplied then return end
      local currentGui = player:FindFirstChild("PlayerGui")
      local reel = currentGui and (currentGui:FindFirstChild("reel")
          or currentGui:FindFirstChild("Reel"))
      local bar = reel and reel:FindFirstChild("bar")
      local playerbar = bar and bar:FindFirstChild("playerbar")
      if not playerbar then
          if barLockReelId then
              barLockFishGeneration = barLockFishGeneration + 1
              barLockReelId, barLockFishCache, barLockFishLoading =
                  nil, nil, false
          end
          return
      end
      local reelId = tostring(reel.Address)
      if reelId ~= barLockReelId then
          barLockFishGeneration = barLockFishGeneration + 1
          barLockReelId, barLockFishCache, barLockFishLoading =
              reelId, nil, false
          barLockScanAt = 0
      end
      if not barLockFishCache and not barLockFishLoading
          and now >= barLockScanAt then
          barLockFishLoading = true
          barLockScanAt = now + 1
          local generation = barLockFishGeneration
          task.spawn(function()
              local ok, cache = pcall(getgc, "fishPosition")
              if not alive or generation ~= barLockFishGeneration then return end
              barLockFishLoading = false
              if ok and type(cache) == "table" and #cache > 0 then
                  barLockFishCache = cache
              end
          end)
      end
      if not barLockFishCache or now < barLockWriteAt then return end
      local ok, playerCenter = pcall(function()
          -- Matcha reports 0x0 AbsoluteSize for the live reel GUI. Read
          -- Position.X.Scale the same way as the reference Lock Bar script.
          local position = playerbar.Position
          if position and position.X
              and type(position.X.Scale) == "number" then
              return position.X.Scale
          end
          if type(memory_read) == "function" then
              local address = tonumber(playerbar.Address)
              if address then
                  local readOk, scale = pcall(memory_read, "float",
                      address + 1296)
                  if readOk and type(scale) == "number"
                      and scale == scale and scale >= 0 and scale <= 1 then
                      return scale
                  end
              end
          end
          local origin, size = bar.AbsolutePosition, bar.AbsoluteSize
          local playerPos, playerSize = playerbar.AbsolutePosition,
              playerbar.AbsoluteSize
          if origin and size and playerPos and size.X > 0 then
              return (playerPos.X + (playerSize and playerSize.X or 0) / 2
                  - origin.X) / size.X
          end
      end)
      if not ok or not playerCenter or playerCenter ~= playerCenter
          or playerCenter < 0 or playerCenter > 1 then return end
      barLockWriteAt = now + 0.05
      local applied, writes = pcall(applygc, barLockFishCache,
          "fishPosition", playerCenter)
      pcall(applygc, barLockFishCache, "onbar", true)
      if not applied or type(writes) ~= "number" or writes == 0 then
          barLockFishCache = nil
          barLockScanAt = now + 1
          warn("Control Bar Lock: fish position write failed")
      end
  end

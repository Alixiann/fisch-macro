      if type(getgc) ~= "function" or type(applygc) ~= "function" then
          warn("Instant Catch requires Matcha getgc / applygc")
          return
      end
      instantGeneration = instantGeneration + 1
      local generation = instantGeneration
      instantLoading = true
      updateInstantLabel()
      task.spawn(function()
          -- Scan once when enabling, then reuse the cache for updates.
          local ok, cache = pcall(getgc, {"progressefficiency"})
          if not alive or generation ~= instantGeneration then return end
          instantLoading = false
          if not ok or not cache then
              updateInstantLabel()

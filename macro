  local function serverClock()
      local minutes
      local source
      for _, attribute in ipairs({"CurrentTime", "currentTime", "MinutesAfterMidnight"}) do
          local value = Lighting:GetAttribute(attribute)
          if type(value) == "number" and value == value
              and math.abs(value) < math.huge then
              minutes, source = value, attribute
              break
          end
      end
      if not minutes then
          local clockTime = Lighting:GetAttribute("ClockTime")
          if type(clockTime) == "number" and clockTime == clockTime
              and math.abs(clockTime) < math.huge then
              minutes, source = clockTime * 60, "ClockTime"
          end
      end
      if not minutes then
          local ok, value = pcall(function()
              return Lighting:GetMinutesAfterMidnight()
          end)
          if ok and type(value) == "number" and value == value
              and math.abs(value) < math.huge then
              minutes, source = value, "GetMinutesAfterMidnight"
          end
      end
      if not minutes then return "?", nil end
      -- Some versions expose CurrentTime as hours while other versions use
      -- minutes.  ClockTime is explicitly hours; normalize it here.
      if source == "CurrentTime" and minutes >= 0 and minutes <= 24 then
          minutes = minutes * 60
      end
      minutes = minutes % 1440
      local hour = math.floor(minutes / 60)
      local minute = math.floor(minutes % 60)
      local suffix = hour >= 12 and "PM" or "AM"
      local displayHour = hour % 12
      if displayHour == 0 then displayHour = 12 end
      return string.format("%d:%02d %s", displayHour, minute, suffix),
          minutes >= 360 and minutes < 1080
  end
  local function cleanText(value)
      if type(value) ~= "string" then return nil end
      value = value:gsub("<[bB][rR]%s*/?>", "\n")
      value = value:gsub("<[^>]*>", "")
      value = value:gsub("&times;", "x")
      value = value:gsub("Ã—", "x")
      value = value:gsub("&nbsp;", " ")
      value = value:gsub("&amp;", "&")
      value = value:gsub("\r", "")
      value = value:match("^%s*(.-)%s*$")
      local lower = value:lower()
      if value == ""
          or lower == "none"
          or lower == "nil"
          or lower == "false"
          or lower == "weather status"
          or lower == "failed to fetch text" then
          return nil
      end
      if value:find("[%z\1-\8\11\12\14-\31]")
          or value:find("ï¿½", 1, true) then
          return nil
      end
      return value
  end

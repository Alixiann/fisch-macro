    if autoTotem.startupCheckPending or now>=autoTotem.nextScan then
        local kind,name=detectSlot9()
        autoTotem.targetKind,autoTotem.targetName=kind,name
        if not kind or kind=="unsupported" then
            autoTotem.pending=false
            autoTotem.startupCheckPending=false
            setTotemStatus(name and ("Unsupported slot 9 item: "..name)
                or "Place a Luck, Tropical Sun, or Rainbow Totem in slot 9.")
            return
        end
        local active=scanTargetEvent(kind,true)
        autoTotem.nextScan=now+autoTotem.scanInterval

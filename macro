            end
            if matches and not owner and (class=="Model" or isPart) then
                owner,ownerName=object,name
            end
            if matches and class=="Model" and not part then
                part=object:FindFirstChildWhichIsA("BasePart",true)
            end
            local stableKey=owner and (owner:GetFullName() or ownerName)
            if part and owner and stableKey and not scan.seen[stableKey]
                and #scan.targets<64 then
                local position=part.Position
                if (position-origin).Magnitude<=700 then
                    scan.seen[stableKey]=true
                    scan.targets[#scan.targets+1]={model=owner,part=part,
                        name=ownerName,key=stableKey,nextText=0}

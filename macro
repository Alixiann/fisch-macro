  local function updateFade(now)
      if not shown and fadeAmount <= 0.001 then return end
      if now - guiPaintAt < 1 / 60 then return end
      guiPaintAt = now
      local dt = math.max(0, now - fadeLastTime)
      fadeLastTime = now
      borderPhase = (borderPhase + dt * 2.4) % (math.pi * 2)
      local pulse = (math.sin(borderPhase) + 1) / 2
      local edgeLevel = 120 + 135 * pulse
      local edgeColor = Color3.fromRGB(edgeLevel, 35, edgeLevel)
      border.Color = edgeColor
      accent.Color = edgeColor
      teleportWindow.border.Color = edgeColor
      -- Keep this numeric when the GUI is hidden; `shown and ...` would
      -- otherwise produce false and the transparency multiplication below
      -- would throw.
      local teleportAlpha = shown
          and (npcMenuOpen and npcMenuAnim or autoTotem.open and autoTotem.anim or 0)
          or 0
      teleportWindow.bg.Transparency = 0.64 * fadeAmount * teleportAlpha
      teleportWindow.border.Transparency = fadeAmount * teleportAlpha
      teleportWindow.bg.Visible = teleportAlpha > 0.001
      teleportWindow.border.Visible = teleportAlpha > 0.001
      local watermarkPulse = (math.sin(borderPhase) + 1) / 2
      watermark.Color = Color3.new(
          C.pink.R + (C.white.R - C.pink.R) * watermarkPulse,
          C.pink.G + (C.white.G - C.pink.G) * watermarkPulse,
          C.pink.B + (C.white.B - C.pink.B) * watermarkPulse
      )
      local target = shown and 1 or 0
      if fadeAmount < target then
          fadeAmount = math.min(target, fadeAmount + dt / FADE_SECONDS)
      elseif fadeAmount > target then
          fadeAmount = math.max(target, fadeAmount - dt / FADE_SECONDS)
      end
      for _, entry in ipairs(layout) do
          local menuAlpha = 1
          if automationMenuDrawings[entry.d] then
              menuAlpha = automationMenuOpen and 1 or 0
          elseif npcMenuDrawings[entry.d] then
              menuAlpha = npcMenuDrawings[entry.d] < 0
                  and (1 - npcMenuAnim) or npcMenuAnim
              if npcMenuDrawings[entry.d] >= 480 then
                  menuAlpha = menuAlpha * (npcSubOpen and 1 or 0)
              end

local function serverClock()
    local minutes,source
    for _,attribute in ipairs({"CurrentTime","currentTime","MinutesAfterMidnight"}) do
        local value
        pcall(function() value=Lighting:GetAttribute(attribute) end)
        if type(value)=="number" and value==value and math.abs(value)<math.huge then
            minutes,source=value,attribute
            break
        end
    end
    if not minutes then
        local value
        pcall(function() value=Lighting:GetAttribute("ClockTime") end)
        if type(value)=="number" and value==value and math.abs(value)<math.huge then
            minutes,source=value*60,"ClockTime"
        end
    end
    if not minutes then
        local ok,value=pcall(function() return Lighting:GetMinutesAfterMidnight() end)
        if ok and type(value)=="number" and value==value and math.abs(value)<math.huge then
            minutes,source=value,"minutes"
        end
    end
    if not minutes then return "?",nil end
    if source=="CurrentTime" and minutes>=0 and minutes<=24 then minutes=minutes*60 end
    minutes=minutes%1440
    local hour=math.floor(minutes/60)
    local suffix=hour>=12 and "PM" or "AM"
    local displayHour=hour%12
    if displayHour==0 then displayHour=12 end
    return string.format("%d:%02d %s",displayHour,math.floor(minutes%60),suffix),
        minutes>=360 and minutes<1080
end

  macroCallbacks.edge = function(key)
      local value = iskeypressed(key)
      local current = value == true
          or (type(value) == "number" and value ~= 0)
      local pressed = current and not previous[key]
      previous[key] = current
      return pressed
  end
  macroCallbacks.track = function(bar, fish, playerbar, now)
      local origin, size = bar.AbsolutePosition, bar.AbsoluteSize
      local fp, fs = fish.AbsolutePosition, fish.AbsoluteSize
      local bp, bs = playerbar.AbsolutePosition, playerbar.AbsoluteSize
      if not (origin and size and fp and fs and bp and bs)
          or size.X <= 0 then
          mouse(false)
          resetTracking()
          return false
      end
      local f = (fp.X + fs.X / 2 - origin.X) / size.X
      local b = (bp.X + bs.X / 2 - origin.X) / size.X
      local width = bs.X / size.X
      if f ~= f or b ~= b or width <= 0
          or math.abs(f) > 5 or math.abs(b) > 5 then
          mouse(false)
          resetTracking()
          return false
      end
      local dt = lastTime and now - lastTime or 0
      if dt > 0 and dt < 0.2 then
          local rawFish = math.clamp((f - lastFish) / dt, -3, 3)
          local rawBar = math.clamp((b - lastBar) / dt, -3, 3)
          local fa = 1 - math.exp(-dt / 0.035)
          local ba = 1 - math.exp(-dt / 0.018)
          if rawFish * fishVelocity < 0 then
              fishVelocity = 0
          end
          fishVelocity += (rawFish - fishVelocity) * fa
          barVelocity += (rawBar - barVelocity) * ba
          local speed = math.abs(fishVelocity)
          local smoothing = speed > activity and 0.04 or 0.30
          local aa = 1 - math.exp(-dt / smoothing)
          activity += (speed - activity) * aa
          if math.abs(rawFish) > 0.04 then
              fishMoving, quietTime = true, 0
          elseif math.abs(rawFish) < 0.015 then
              quietTime += dt
              if quietTime >= 0.06 then
                  fishMoving = false
                  fishVelocity = 0
              end
          else
              quietTime = 0
          end
      else
          fishVelocity, barVelocity = 0, 0
          fishMoving, quietTime = false, 0
          activity = 0
      end
      lastFish, lastBar, lastTime = f, b, now
      local fast = math.clamp((activity - 0.06) / 0.24, 0, 1)
      local target, feedForward = f, 0
      if fishMoving then
          local limit = math.min(width * 0.12, 0.025)
          local predictionTime = 0.015 + 0.030 * fast
          target = math.clamp(
              f + math.clamp(
                  fishVelocity * predictionTime,
                  -limit, limit
              ),
              0, 1
          )
          feedForward = fishVelocity
      end
      local originalGain = fishMoving and 5 or 8
      local gain = 3.5 + (originalGain - 3.5) * fast
      local errorPosition = target - b
      local tolerance = math.min(width * 0.035, 0.008) * (1 - fast)
      if math.abs(errorPosition) <= tolerance then
          errorPosition = 0
      elseif tolerance > 0 then
          if errorPosition > 0 then
              errorPosition -= tolerance
          else
              errorPosition += tolerance
          end
      end
      local wantedVelocity = math.clamp(
          feedForward + errorPosition * gain,
          -1.5, 1.5
      )
      local errorVelocity = wantedVelocity - barVelocity
      local originalThreshold = fishMoving and 0.025 or 0.012
      local threshold = 0.030 + (originalThreshold - 0.030) * fast
      local desired = held
      if errorVelocity > threshold then
          desired = true
      elseif errorVelocity < -threshold then
          desired = false
      end
      if math.abs(f - b) > width * 0.5 then
          desired = f > b
      end
      mouse(desired)
      return true
  end

  local function castReading()
      if not castMeter then
          local character = player.Character
          local root = character and character:FindFirstChild("HumanoidRootPart")
          local power = root and root:FindFirstChild("power")
          castMeter = power and power:FindFirstChild("powerbar")
          castFill = castMeter and castMeter:FindFirstChild("bar")
          castGreen = castMeter and castMeter:FindFirstChild("green")
      end
      if not (castMeter and castFill and castGreen) then return nil end
      local size, origin = castMeter.AbsoluteSize, castMeter.AbsolutePosition
      local fillSize = castFill.AbsoluteSize
      local greenSize, greenPos = castGreen.AbsoluteSize, castGreen.AbsolutePosition
      if not (size and origin and fillSize and greenSize and greenPos)
          or size.Y <= 0 or greenSize.Y <= 0 then return nil end

      -- Fisch fills this vertical meter upwards. Read the actual green frame.
      local amount = math.clamp(fillSize.Y / size.Y, 0, 1)
      local lower = math.clamp(1 - (greenPos.Y + greenSize.Y - origin.Y) / size.Y, 0, 1)
      local upper = math.clamp(1 - (greenPos.Y - origin.Y) / size.Y, 0, 1)
      if upper <= lower then return nil end
      local target = lower + (upper - lower) * 0.75
      return amount * 100, amount >= target and amount <= upper
  end

  local function releaseKey()
      if pendingKey then
          keyrelease(pendingKey)
          pendingKey = nil
          keyReleaseAt = nil
      end
  end

  local function tap(key, now)
      if pendingKey or navigationReleaseAt
          or now < navigationReadyAt then
          return false
      end

      pendingKey = key
      keyReleaseAt = now + KEY_HOLD
      keypress(key)
      return true
  end

  local function setNavigation(value)
      navigationWanted = value

      if navigationOn == value or navigationReleaseAt then
          return
      end

      releaseKey()
      keypress(0xDC)

      navigationOn = value
      navigationReleaseAt = tick() + KEY_HOLD
      navigationReadyAt = navigationReleaseAt + 0.12
  end

  local function updateKeys(now)
      if pendingKey and now >= keyReleaseAt then
          releaseKey()
      end

      if navigationReleaseAt and now >= navigationReleaseAt then
          keyrelease(0xDC)
          navigationReleaseAt = nil
      end

      if not navigationReleaseAt
          and navigationWanted ~= navigationOn then
          setNavigation(navigationWanted)
      end
  end


  local function layoutTeleportMenus()
      -- Tiny slide animation:
      -- NPC expansion pushes the Totems header down smoothly. Totems then
      -- push the Islands header down, and Islands grow the panel bottom.
      totemMenu.top = 388 + (npcSubOpen and 368 or 95) * npcMenuAnim
      islandMenu.top = totemMenu.top + 48 + 221 * (totemMenu.open and 1 or 0)
      npcArrow.Text = npcMenuOpen and "^" or "v"
      npcSubArrow.Text = npcSubOpen and "^" or "v"
      totemMenu.arrow.Text = totemMenu.open and "^" or "v"
      islandMenu.arrow.Text = islandMenu.open and "^" or "v"

      PANEL_H = islandMenu.top + 32 + 221 * islandMenu.anim

      -- Do NOT write the raw/unscaled Size here.
      -- positionPanel() applies uiScale from baseSize below. Writing the
      -- unscaled size first causes a visible base-size flash when uiScale > 1.
      -- Keep the cached layout size in sync with the animated height.
      -- positionPanel() uses baseSize, so leaving the old size cached can
      -- momentarily redraw the previous panel/border position.
      for _, entry in ipairs(layout) do
          if entry.d == bg or entry.d == border then
              -- Keep BOTH the background and animated purple outline at the
              -- current dropdown height before positionPanel() draws them.
              -- Otherwise the border briefly uses its previous cached height,
              -- causing a purple horizontal line to flash at the old bottom.
              entry.baseSize = Vector2.new(PANEL_W, PANEL_H)
          end
      end

      local backdropHeight = math.max(0, PANEL_H - 388)
      menuBackdropLayout.y = 388
      -- Same rule as the main background: cache the logical size and let
      -- positionPanel() apply uiScale once, avoiding an unscaled flash.
      menuBackdropLayout.baseSize = Vector2.new(PANEL_W, backdropHeight)
      menuBackdrop.Visible = math.max(npcMenuAnim, totemMenu.anim) > 0.001

      for _, entry in ipairs(layout) do
          if entry.d == totemMenu.title then
              entry.y = totemMenu.top + 8
          elseif entry.d == totemMenu.arrow then
              entry.y = totemMenu.top + 6
          elseif entry.d == islandMenu.title then
              entry.y = islandMenu.top + 8
          elseif entry.d == islandMenu.arrow then
              entry.y = islandMenu.top + 6
          elseif islandMenu.drawings[entry.d] then
              entry.y = islandMenu.top + islandMenu.drawings[entry.d]
                  - (1 - islandMenu.anim) * 6
          elseif npcMenuDrawings[entry.d] then
              -- Content rises the last few pixels while fading in.
              entry.y = npcMenuDrawings[entry.d] - (1 - npcMenuAnim) * 6
          elseif totemMenu.drawings[entry.d] then
              entry.y = totemMenu.top + totemMenu.drawings[entry.d]
                  - (1 - totemMenu.anim) * 6
          end
      end

      for i, d in ipairs(totemMenu.slots) do
          local row = totemMenu.rows[(totemMenu.page - 1) * totemMenu.pageSize + i]
          d.Text = row and row.name or ""
      end

      totemMenu.pageLabel.Text = totemMenu.page .. " / "
          .. math.ceil(#totemMenu.rows / totemMenu.pageSize)
      for i, d in ipairs(islandMenu.slots) do
          local row = islandMenu.rows[(islandMenu.page - 1) * islandMenu.pageSize + i]
          d.Text = row and row.name or ""
          for _, entry in ipairs(layout) do
              if entry.d == d then
                  entry.y = islandMenu.top + 38 + (i - 1) * 27
                  break
              end
          end
      end
      islandMenu.pageLabel.Text = islandMenu.page .. " / "
          .. math.ceil(#islandMenu.rows / islandMenu.pageSize)

      -- Keep the panel anchored in the same place while its height animates.
      panelX, panelY = lastPanelX, lastPanelY
      lastPanelX, lastPanelY = nil, nil
      positionPanel()
  end

  local function updateDropdownAnimation(now)
      local dt = math.max(0, math.min(0.05, now - dropdownAnimLast))
      dropdownAnimLast = now

      local npcTarget = npcMenuOpen and 1 or 0
      local totemTarget = totemMenu.open and 1 or 0
      local islandTarget = islandMenu.open and 1 or 0

      -- Exponential easing gives a short, soft pop without feeling floaty.
      local blend = 1 - math.exp(-dt * 24)
      npcMenuAnim = npcMenuAnim + (npcTarget - npcMenuAnim) * blend
      totemMenu.anim = totemMenu.anim + (totemTarget - totemMenu.anim) * blend
      islandMenu.anim = islandMenu.anim + (islandTarget - islandMenu.anim) * blend

      if math.abs(npcMenuAnim - npcTarget) < 0.002 then
          npcMenuAnim = npcTarget
      end
      if math.abs(totemMenu.anim - totemTarget) < 0.002 then
          totemMenu.anim = totemTarget
      end
      if math.abs(islandMenu.anim - islandTarget) < 0.002 then
          islandMenu.anim = islandTarget
      end

      layoutTeleportMenus()
  end

  local function teleportTotem(row)
      enabled, equipPending = false, false
      mouse(false)
      releaseKey()
      setNavigation(false)
      releaseAt, idleSince = nil, nil
      resetTracking()
      if _G.StopAuroraRoute then _G.StopAuroraRoute() end
      local character = player.Character
      local root = character and character:FindFirstChild("HumanoidRootPart")
      if not root then totemMenu.status.Text = "Waiting for your character"; return end
      local pos = Vector3.new(row.pos[1], row.pos[2], row.pos[3])
      local live = false
      -- Prefer a matching shop display near this location, ignoring held Tools.
      pcall(function()
          local targetName = npcName(row.match or row.name) .. "totem"
          for _, object in ipairs(W:GetDescendants()) do
              if npcName(object.Name) == targetName then
                  local node, heldTool = object, false
                  while node and node ~= W do
                      if node.ClassName == "Tool" then heldTool = true; break end
                      node = node.Parent
                  end
                  if not heldTool then
                      local part
                      if object:IsA("BasePart") then part = object
                      elseif object.ClassName == "Model" then
                          part = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
                      end
                      if part and (part.Position - pos).Magnitude < 200 then
                          pos, live = part.Position, true
                          break
                      end
                  end
              end
          end
      end)
      local ok, err = pcall(function()
          root.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z + 3)
      end)
      totemMenu.status.Text = ok and (live and "At shop display; buy manually" or "At mapped shop; buy manually")
          or "Teleport write failed"
      if not ok then warn("Totem teleport: " .. tostring(err)) end
  end

  local function findIslandPosition(row)
      if not row.match then return nil end
      for _, object in ipairs(W:GetDescendants()) do
          local normalized = npcName(object.Name)
          for _, alias in ipairs(row.match) do
              if normalized == alias then
                  local part
                  if object:IsA("BasePart") then
                      part = object
                  elseif object.ClassName == "Model" then
                      part = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
                  end
                  if part then return part.Position end
              end
          end
      end
  end


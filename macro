          and math.abs(totemMenu.anim - totemTarget) < 0.0001
          and math.abs(islandMenu.anim - islandTarget) < 0.0001
          and math.abs(autoTotem.anim - autoTotemTarget) < 0.0001 then
          return
      end
      local blend = math.min(1, dt * 18)
      npcMenuAnim = npcMenuAnim + (npcTarget - npcMenuAnim) * blend
      totemMenu.anim = totemMenu.anim + (totemTarget - totemMenu.anim) * blend
      islandMenu.anim = islandMenu.anim + (islandTarget - islandMenu.anim) * blend
      autoTotem.anim = autoTotem.anim + (autoTotemTarget - autoTotem.anim) * blend

  rodSpeed.updateTyping = function()
      if not rodSpeed.editing then return end
      local ctrl = iskeypressed(0x11) == true
      local paste = iskeypressed(0x56) == true
      if ctrl and paste and not rodSpeed.keys[0x100] then
          local getter = type(getclipboard) == "function" and getclipboard
              or type(get_clipboard) == "function" and get_clipboard
          if getter then
              local ok, value = pcall(getter)
              if ok then rodSpeed.text = tostring(value or "") end
          end
      end
      rodSpeed.keys[0x100] = ctrl and paste
      local keys = {
          [0x30] = "0", [0x31] = "1", [0x32] = "2", [0x33] = "3", [0x34] = "4",
          [0x35] = "5", [0x36] = "6", [0x37] = "7", [0x38] = "8", [0x39] = "9",
          [0x60] = "0", [0x61] = "1", [0x62] = "2", [0x63] = "3", [0x64] = "4",
          [0x65] = "5", [0x66] = "6", [0x67] = "7", [0x68] = "8", [0x69] = "9",
      }
      for code, character in pairs(keys) do
          local down = iskeypressed(code) == true
          if down and not ctrl and not rodSpeed.keys[code] then
              rodSpeed.text = rodSpeed.text .. character
          end
          rodSpeed.keys[code] = down
      end
      local period = iskeypressed(0xBE) == true or iskeypressed(0x6E) == true
      if period and not rodSpeed.keys[0x101] then rodSpeed.text = rodSpeed.text .. "." end
      rodSpeed.keys[0x101] = period
      local minus = iskeypressed(0xBD) == true or iskeypressed(0x6D) == true
      if minus and not rodSpeed.keys[0x102] and not rodSpeed.text:find("-", 1, true) then
          rodSpeed.text = "-" .. rodSpeed.text
      end
      rodSpeed.keys[0x102] = minus
      local plus = iskeypressed(0xBB) == true
      if plus and not rodSpeed.keys[0x103] and not rodSpeed.text:find("+", 1, true) then
          rodSpeed.text = "+" .. rodSpeed.text
      end
      rodSpeed.keys[0x103] = plus
      rodSpeed.text = rodSpeed.text:sub(1, 32)
      local backspace = iskeypressed(0x08) == true
      if backspace and not rodSpeed.keys[0x08] then
          rodSpeed.text = rodSpeed.text:sub(1, math.max(0, #rodSpeed.text - 1))
      end
      rodSpeed.keys[0x08] = backspace
      local enter = iskeypressed(0x0D) == true
      if enter and not rodSpeed.keys[0x0D] then
          rodSpeed.editing = false
          pcall(setrobloxinput, true)
          rodSpeed.apply()
      end
      rodSpeed.keys[0x0D] = enter
      rodSpeed.updateLabel()
      if rodSpeed.enabled then rodSpeed.apply() end
  end

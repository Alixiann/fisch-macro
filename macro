  local function mouse(value)
      if held == value then return end
      held = value
      if value then
          mouse1press()
      else
          mouse1release()
          releaseAt = nil
          castMeter, castFill, castGreen = nil, nil, nil
          perfectCastNextUpdate = 0
          perfectCastPercent, perfectCastInGreen = nil, false
      end

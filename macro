  local function castReading()
      if not castMeter then
          local character = player.Character
          local root = character and character:FindFirstChild("HumanoidRootPart")
          local power = root and root:FindFirstChild("power")
          castMeter = power and power:FindFirstChild("powerbar")
          castFill = castMeter and castMeter:FindFirstChild("bar")
          castGreen = castMeter and castMeter:FindFirstChild("green")
      end
      if not (castMeter and castFill and castGreen) then return nil end
      local size, origin = castMeter.AbsoluteSize, castMeter.AbsolutePosition
      local fillSize = castFill.AbsoluteSize
      local greenSize, greenPos = castGreen.AbsoluteSize, castGreen.AbsolutePosition
      if not (size and origin and fillSize and greenSize and greenPos)
          or size.Y <= 0 or greenSize.Y <= 0 then return nil end
      local amount = math.clamp(fillSize.Y / size.Y, 0, 1)
      local lower = math.clamp(1 - (greenPos.Y + greenSize.Y - origin.Y) / size.Y, 0, 1)
      local upper = math.clamp(1 - (greenPos.Y - origin.Y) / size.Y, 0, 1)
      if upper <= lower then return nil end
      local target = lower + (upper - lower) * 0.75
      return amount * 100, amount >= target and amount <= upper
  end

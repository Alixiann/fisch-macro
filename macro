  local function activeShakeButton()
      local currentGui = player:FindFirstChildOfClass("PlayerGui")
      local shakeGui = currentGui and currentGui:FindFirstChild("shakeui")
      if not shakeGui then return nil end
      local function visibleInTree(object)
          local node = object
          while node and node ~= shakeGui do
              local ok, visible = pcall(function() return node.Visible end)
              if ok and visible == false then return false end
              node = node.Parent
          end
          return true
      end
      local function hasShakeText(object)
          local ok, value = pcall(function() return object.Text end)
          return ok and type(value) == "string"
              and value:lower():find("shake", 1, true) ~= nil
      end
      -- Find the actual circular control by its visible "Shake" text.
      for _, object in ipairs(shakeGui:GetDescendants()) do
          if (object:IsA("GuiButton") or object:IsA("TextLabel"))
              and visibleInTree(object) and hasShakeText(object) then
              local node = object
              while node and node ~= shakeGui do
                  if node:IsA("GuiButton") then return node end
                  node = node.Parent
              end
              if object:IsA("GuiButton") then return object end
          end
      end
      return nil
  end

  local function moveMouseFast(x, y)
      if type(mousemoveabs) == "function" then
          return pcall(mousemoveabs, x, y)
      elseif type(setcursorpos) == "function" then
          return pcall(setcursorpos, x, y)
      elseif type(mousemoverel) == "function" then
          local cx, cy = cursor.X, cursor.Y
          if type(cx) == "number" and type(cy) == "number" then
              return pcall(mousemoverel, x - cx, y - cy)
          end
      end
      return false
  end

  -- Independent watcher, matching the reference script's ChildAdded-style
  -- behavior. This keeps shaking alive even while the cast loop is changing
  -- states between bite, shake, and reel.
  local lastShakeX, lastShakeY
  local lastShakeMoveAt = tick()
  task.spawn(function()
      while alive do
          if enabled and not panelInputCaptured then
              local button = activeShakeButton()
              if button then
                  local buttonX, buttonY
                  pcall(function()
                      local p, size = button.AbsolutePosition, button.AbsoluteSize
                      local x, y = p.X + size.X / 2, p.Y + size.Y / 2
                      buttonX, buttonY = x, y
                      moveMouseFast(x, y)
                      pcall(mouse1press)
                      task.wait(0.02)
                      pcall(mouse1release)
                      VirtualInputManager:SendMouseButtonEvent(
                          x, y, 0, true, player, 0)
                      VirtualInputManager:SendMouseButtonEvent(
                          x, y, 0, false, player, 0)
                  end)
                  if buttonX then
                      if not lastShakeX
                          or math.abs(buttonX - lastShakeX) > 2
                          or math.abs(buttonY - lastShakeY) > 2 then
                          lastShakeX, lastShakeY = buttonX, buttonY
                          lastShakeMoveAt = tick()
                      elseif tick() - lastShakeMoveAt >= 1 then
                          -- Re-trigger the UI even when its position has stayed
                          -- fixed; this helps recover from an occasional missed
                          -- shake click or stale input state.
                          moveMouseFast(buttonX + 3, buttonY)
                          task.wait(0.02)
                          moveMouseFast(buttonX, buttonY)
                          lastShakeMoveAt = tick()
                      end
                  end
                  task.wait(0.1)
              else
                  task.wait(0.03)
              end
          else
              task.wait(0.05)
          end
      end
  end)


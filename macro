                              display("INSTANT CAST")
                          elseif castMode == "Perfect" and inGreen then
                              mouse(false)
                              releaseAt = nil
                              nextCast = now + RETRY
                              display(string.format("CAST %.0f%% / GREEN", percent))
                          elseif now - releaseAt >= CAST_TIMEOUT then
                              mouse(false)
                              releaseAt = nil
                              nextCast = now + RETRY
                              display("CAST METER UNAVAILABLE / RETRY")
                          else
                              display(castMode == "Instant" and "INSTANT CAST"
                                  or percent and string.format("CAST %.0f%% / 100%%", percent)
                                  or "WAITING FOR CAST METER")
                          end

                      elseif dragging then
                          display("MOVING PANEL")
                      elseif now >= nextCast and equippedRod() then
                          castMeter, castFill, castGreen = nil, nil, nil
                          mouse(true)
                          releaseAt = now -- Start of charge; not a release deadline.
                          display(castMode == "Instant" and "INSTANT CAST" or "CAST 0% / 100%")
                      else
                          display("WAITING FOR BITE")
                      end
                  end
              end

              if now >= nextStats then
                  refreshStats(now)
                  nextStats = now + 0.5
              end

              updateDropdownAnimation(now)
              updateFade(now)
              task.wait(0.01)
          end
      end)

      if not ok then
          stop()
          warn("Fisch Macro stopped: " .. tostring(err))
      end
  end)


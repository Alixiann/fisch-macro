  local function updateCustomGpsTyping()
      if not customGpsEditing then return end
      local ctrl = iskeypressed(0x11) == true
      local paste = iskeypressed(0x56) == true
      if ctrl and paste and not customGpsKeys[0x100] then
          local getter = type(getclipboard) == "function" and getclipboard
              or type(get_clipboard) == "function" and get_clipboard
              or type(readclipboard) == "function" and readclipboard
          if getter then
              local ok, value = pcall(getter)
              if ok then customGpsText = tostring(value or "") end
          end
      end
      customGpsKeys[0x100] = ctrl and paste
      local keys = {
          [0x30] = "0", [0x31] = "1", [0x32] = "2", [0x33] = "3", [0x34] = "4",
          [0x35] = "5", [0x36] = "6", [0x37] = "7", [0x38] = "8", [0x39] = "9",
          [0xBC] = ",", [0xBE] = ".", [0xBD] = "-", [0x20] = " ",
          [0x60] = "0", [0x61] = "1", [0x62] = "2", [0x63] = "3", [0x64] = "4",
          [0x65] = "5", [0x66] = "6", [0x67] = "7", [0x68] = "8", [0x69] = "9",
          [0x6E] = ".", [0x6D] = "-",
      }
      for code, character in pairs(keys) do
          local down = iskeypressed(code) == true
          if down and not customGpsKeys[code] then customGpsText = customGpsText .. character end
          customGpsKeys[code] = down
      end
      local backspace = iskeypressed(0x08) == true
      if backspace and not customGpsKeys[0x08] then
          customGpsText = customGpsText:sub(1, math.max(0, #customGpsText - 1))
      end
      customGpsKeys[0x08] = backspace
      local enter = iskeypressed(0x0D) == true
      if enter and not customGpsKeys[0x0D] then
          customGpsEditing = false
          pcall(setrobloxinput, true)
      end
      customGpsKeys[0x0D] = enter
      updateCustomGpsDisplay()
  end
  fishEsp.normalize = function(value)
      return tostring(value or ""):lower():gsub("[^%w]", "")
  end
  fishEsp.isHuntName = function(value)
      local name = fishEsp.normalize(value)
      for _, pattern in ipairs({
          "megalodon", "seiwhale", "isonade", "colossalsquid",
          "mosasaurus", "nessie", "leviathan", "kraken", "whaleshark",
          "scylla", "colossaldragon", "frostwyrm", "tidefall", "patshark",
      }) do
          if name:find(pattern, 1, true) then return true end
      end
      return false
  end
  fishEsp.huntRoots = function()
      local roots, seen = {}, {}
      local function add(root)
          if root and not seen[root] then
              seen[root] = true
              roots[#roots + 1] = root
          end
      end
      local active = W:FindFirstChild("active")
      add(active and active:FindFirstChild("FinalAbundanceSpawns"))
      add(W:FindFirstChild("DreadfinHuntPools"))
      local hades = W:FindFirstChild("HadesStuff")
      add(hades and hades:FindFirstChild("Hunt"))
      -- Some hunt fish are replicated through the regular fish hierarchy
      -- when they are close enough to stream in.  This is an exact hunt-name
      -- fallback only; normal roaming fish are never accepted as targets.
      add(active and active:FindFirstChild("roamingFish"))
      for _, root in ipairs(W:GetDescendants()) do
          local name = root.Name:lower()
          if name == "newabundances" or name == "abundancespawns"
              or name == "huntpools" or name == "hunt" then
              add(root)
          end
      end
      return roots
  end
  fishEsp.distance = function(a, b)
      local prev = {}
      for j = 0, #b do prev[j] = j end
      for i = 1, #a do
          local cur = {[0] = i}
          for j = 1, #b do
              cur[j] = math.min(cur[j - 1] + 1, prev[j] + 1,
                  prev[j - 1] + (a:sub(i, i) == b:sub(j, j) and 0 or 1))
          end
          prev = cur
      end
      return prev[#b]
  end

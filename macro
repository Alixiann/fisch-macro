  local function castReading()
      if not (castMeter and castMeter.Parent and castFill and castFill.Parent) then
          castMeter, castFill, castGreen = nil, nil, nil
          local character = player.Character
          local root = character and character:FindFirstChild("HumanoidRootPart")
          local power = root and root:FindFirstChild("power")
          castMeter = power and (power:FindFirstChild("powerbar")
              or power:FindFirstChild("PowerBar") or power:FindFirstChild("bar"))
          if not castMeter then
              local currentGui = player:FindFirstChild("PlayerGui")
              for _, object in ipairs(currentGui and currentGui:GetDescendants() or {}) do
                  local name = tostring(object.Name):lower()
                  if (name == "powerbar" or name == "castbar")
                      and (object.ClassName == "Frame" or object.ClassName == "ImageLabel") then
                      castMeter = object
                      break
                  end
              end
          end
          local castBar = castMeter and castMeter:FindFirstChild("bar")
          castFill = castBar and (castBar:FindFirstChild("fill")
              or castBar:FindFirstChild("Fill") or castBar)
              or castMeter and (castMeter:FindFirstChild("fill")
                  or castMeter:FindFirstChild("Fill"))
          castGreen = castMeter and (castMeter:FindFirstChild("green")
              or castMeter:FindFirstChild("perfect") or castMeter:FindFirstChild("Perfect"))
      end
      if not (castMeter and castFill) then return nil end
      local visible = true
      pcall(function()
          visible = castMeter.Visible ~= false and castFill.Visible ~= false
      end)
      if not visible then return nil end
      local size, origin = castMeter.AbsoluteSize, castMeter.AbsolutePosition
      local fillSize = castFill.AbsoluteSize
      if not (size and origin and fillSize) or size.Y <= 0 then return nil end
      local amount = math.clamp(fillSize.Y / size.Y, 0, 1)
      if not castGreen then return amount * 100, amount >= 0.98 end
      local greenSize, greenPos = castGreen.AbsoluteSize, castGreen.AbsolutePosition
      if not (greenSize and greenPos) or greenSize.Y <= 0 then
          return amount * 100, false
      end
      local lower = math.clamp(1 - (greenPos.Y + greenSize.Y - origin.Y) / size.Y, 0, 1)
      local upper = math.clamp(1 - (greenPos.Y - origin.Y) / size.Y, 0, 1)
      if upper <= lower then return nil end
      -- Perfect mode samples this meter every 0.1s.  Use the complete green
      -- interval so a sample near the start of the zone is not discarded.
      local tolerance = 0.015
      return amount * 100,
          amount >= lower - tolerance and amount <= upper + tolerance
  end

  -- Matcha allows at most 200 live top-level locals. Keep the final handlers
  -- in one namespaced table so they do not consume additional local registers.
  macroCallbacks = macroCallbacks or {}
  macroCallbacks.stellarwaveImage = function(node)
      local ok, value = pcall(function() return node.Image end)
      if ok and type(value) == "string" and value ~= "" then return value end
      return nil
  end
  macroCallbacks.stellarwaveSymbol = function(node)
      local nodeName = tostring(node.Name):lower()
      if nodeName:match("^sign%d+$") then
          return "slot:" .. nodeName
      end
      local preferred
      for _, child in ipairs(node:GetDescendants()) do
          local name = tostring(child.Name):lower()
          if name == "basesign" or (name == "sign" and child.ClassName == "ImageLabel") then
              preferred = macroCallbacks.stellarwaveImage(child)
              if preferred then break end
          end
      end
      local image = preferred or macroCallbacks.stellarwaveImage(node)
      if image then return "image:" .. image end
      local name = nodeName:gsub("%s+", "")
      if name ~= "" and name ~= "sign" and name ~= "sign2" and name ~= "star"
          and name ~= "fill" and name ~= "glow" then
          return "name:" .. name
      end
      return nil
  end
  macroCallbacks.stellarwaveVisible = function(node)
      local current = node
      while current do
          local ok, visible = pcall(function() return current.Visible end)
          if ok and visible == false then return false end
          local enabledOk, enabledValue = pcall(function() return current.Enabled end)
          if enabledOk and enabledValue == false then return false end
          current = current.Parent
      end
      return true
  end
  macroCallbacks.stellarwaveFindRoot = function()
      local currentGui = player:FindFirstChildOfClass("PlayerGui")
      if not currentGui then return nil end
      for _, candidateName in ipairs({
          "StarRiddles", "stellarwave", "Stellarwave", "StellarwaveMelody",
          "StellarwaveMelody_ZodiacWheel", "ZodiacWheel", "zodiacWheel",
      }) do
          local candidate = currentGui:FindFirstChild(candidateName)
          if candidate then return candidate end
      end
      for _, item in ipairs(currentGui:GetDescendants()) do
          local itemName = tostring(item.Name):lower()
          if itemName == "wheel" then
              local candidate = item
              while candidate.Parent and candidate.Parent ~= currentGui do
                  candidate = candidate.Parent
              end
              return candidate
          end
      end
      for _, item in ipairs(currentGui:GetDescendants()) do
          local name = tostring(item.Name):lower()
          if name == "signbar" or name == "signcontainer" then
              local candidate = item
              while candidate.Parent and candidate.Parent ~= currentGui do
                  candidate = candidate.Parent
              end
              return candidate
          end
      end
      return nil
  end
  macroCallbacks.stellarwaveClick = function(button)
      local ok, clicked = pcall(function()
          -- StarRiddles uses twelve full-size sign Frames.  Their Frame
          -- centers all overlap at the wheel center, so click the rendered
          -- symbol child instead of the container.
          local target = button
          local preferred
          for _, child in ipairs(button:GetChildren()) do
              local childName = tostring(child.Name):lower()
              if childName == "basesign" or childName == "glowsign" then
                  preferred = child
                  if childName == "basesign" then break end
              end
          end
          if preferred then target = preferred end
          local position, size = target.AbsolutePosition, target.AbsoluteSize
          if not position or not size or size.X <= 8 or size.Y <= 8 then return false end
          local x, y = position.X + size.X / 2, position.Y + size.Y / 2
          moveMouseFast(x, y)
          if type(mouse1click) == "function" then
              mouse1click()
          else
              VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, player, 0)
              VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, player, 0)
          end
          return true
      end)
      return ok and clicked == true
  end
  macroCallbacks.stellarwaveDone = function(node)
      -- A completed riddle has a thin horizontal fill/progress bar below
      -- its symbol.  Do not use Visible/Color here: those properties are not
      -- exposed consistently by Matcha, while the absolute geometry is.
      local ok, nodePosition = pcall(function() return node.AbsolutePosition end)
      local sizeOk, nodeSize = pcall(function() return node.AbsoluteSize end)
      if not ok or not sizeOk or not nodePosition or not nodeSize then return false end
      local nodeBottom = nodePosition.Y + nodeSize.Y
      for _, child in ipairs(node:GetDescendants()) do
          local childName = tostring(child.Name):lower()
          local namedBar = childName:find("bar", 1, true)
              or childName:find("progress", 1, true)
              or childName:find("complete", 1, true)
              or childName:find("done", 1, true)
          local childOk, childPosition = pcall(function() return child.AbsolutePosition end)
          local childSizeOk, childSize = pcall(function() return child.AbsoluteSize end)
          if childOk and childSizeOk and childPosition and childSize
              and childSize.X > childSize.Y * 2
              and childPosition.Y >= nodeBottom - 8 then
              -- Names are useful when available, but the live UI can use a
              -- generic Frame/ImageLabel.  A thin, wide child directly below
              -- the symbol is the visual completion bar in either case.
              local geometricBar = childSize.X >= math.max(12, nodeSize.X * 0.72)
              if namedBar or geometricBar then
                  local filled = childSize.X >= math.max(12, nodeSize.X * 0.72)
                  if filled or childName:find("complete", 1, true)
                      or childName:find("done", 1, true) then
                      return true
                  end
              end
          end
      end
      return false
  end
  macroCallbacks.stellarwaveSequenceKey = function(node)
      local function keyFor(candidate)
          local name = tostring(candidate.Name):lower()
          local number = name:match("^sign(%d+)$") or name:match("^symbol(%d+)$")
              or name:match("^icon(%d+)$")
          if number then return "slot:sign" .. number end
          if name:match("^%d+$") then return "slot:sign" .. name end
          local image = macroCallbacks.stellarwaveImage(candidate)
          if image then return "image:" .. image end
          local value
          pcall(function() value = candidate.Value end)
          if type(value) == "string" and value ~= "" then
              local valueNumber = value:lower():match("sign(%d+)")
              if valueNumber then return "slot:sign" .. valueNumber end
              if value:match("^%d+$") then return "slot:sign" .. value end
              if value:find("rbxasset", 1, true) or value:find("http", 1, true) then
                  return "image:" .. value
              end
          end
          local text
          pcall(function() text = candidate.Text end)
          if type(text) == "string" and text ~= "" then
              local textNumber = text:lower():match("sign(%d+)")
              if textNumber then return "slot:sign" .. textNumber end
          end
          return nil
      end
      local ownKey = keyFor(node)
      if ownKey then return ownKey end
      local preferredNames = {
          basesign = true, sign = true, symbol = true, icon = true,
          image = true, imagelabel = true, imagebutton = true, texture = true,
      }
      local candidates = {}
      for _, child in ipairs(node:GetChildren()) do candidates[#candidates + 1] = child end
      for _, child in ipairs(node:GetDescendants()) do candidates[#candidates + 1] = child end
      for _, child in ipairs(candidates) do
          local name = tostring(child.Name):lower()
          if preferredNames[name] then
              local key = keyFor(child)
              if key then return key end
          end
      end
      for _, child in ipairs(candidates) do
          local key = keyFor(child)
          if key then return key end
      end
      return nil
  end
  macroCallbacks.stellarwaveSequence = function(root)
      local source = root:FindFirstChild("riddles")
          or root:FindFirstChild("signbar")
      local sequence = {}
      if not source then return sequence end
      -- Each direct child is one ordered riddle slot.  Resolve one symbol
      -- from that child, rather than appending every descendant ImageLabel;
      -- otherwise the progress bar itself can become a false symbol.
      for _, item in ipairs(source:GetChildren()) do
          if not macroCallbacks.stellarwaveDone(item) then
              local key = macroCallbacks.stellarwaveSequenceKey(item)
              if key and (key:sub(1, 5) == "slot:" or key:sub(1, 6) == "image:") then
                  sequence[#sequence + 1] = key
              end
          end
      end
      return sequence
  end
  macroCallbacks.stellarwave = function(now, focused)
      local state = stellarwaveState
      if not focused then
          state.root = nil
          state.wheel = nil
          state.buttons = {}
          state.sequence = {}
          state.sequenceKey = ""
          state.sequenceLocked = false
          state.completedSequenceKey = ""
          state.nextIndex = 1
          state.lastActiveKey = nil
          return false
      end
      if now - state.lastRootScan >= 0.45 then
          state.lastRootScan = now
          local root = macroCallbacks.stellarwaveFindRoot()
          if root ~= state.root then
              state.root = root
              state.wheel = root and root:FindFirstChild("wheel") or nil
              state.buttons = {}
              state.sequence = {}
              state.sequenceKey = ""
              state.sequenceLocked = false
              state.completedSequenceKey = ""
              state.nextIndex = 1
              state.nextClickAt = 0
              state.lastActiveKey = nil
          end
      end
      local root = state.root
      if not root or not macroCallbacks.stellarwaveVisible(root) then return false end
      if now - state.lastButtonScan >= 0.10 then
          state.lastButtonScan = now
          local buttons = {}
          local wheel = state.wheel or root:FindFirstChild("wheel") or root
          state.wheel = wheel
          for _, object in ipairs(wheel:GetChildren()) do
              local class = object.ClassName
              local objectName = tostring(object.Name):lower()
              if (class == "TextButton" or class == "ImageButton"
                  or (class == "Frame" and objectName:match("^sign%d+$")))
                  and not objectName:find("close", 1, true)
                  and not objectName:find("cancel", 1, true)
                  and not objectName:find("modal", 1, true) then
                  local key = macroCallbacks.stellarwaveSymbol(object)
                  local imageKey
                  local imageCandidates = {}
                  for _, child in ipairs(object:GetChildren()) do imageCandidates[#imageCandidates + 1] = child end
                  for _, child in ipairs(object:GetDescendants()) do imageCandidates[#imageCandidates + 1] = child end
                  for _, child in ipairs(imageCandidates) do
                      local childName = tostring(child.Name):lower()
                      if childName == "basesign" or childName == "glowsign"
                          or childName == "sign" or childName == "symbol" then
                          local image = macroCallbacks.stellarwaveImage(child)
                          if image then imageKey = "image:" .. image end
                          if imageKey then break end
                      end
                  end
                  local ok, size = pcall(function() return object.AbsoluteSize end)
                  if key and ok and size and size.X > 8 and size.Y > 8 then
                      buttons[#buttons + 1] = {
                          object = object,
                          key = key,
                          imageKey = imageKey,
                      }
                  end
              end
          end
          table.sort(buttons, function(left, right)
              local leftNumber = tonumber(tostring(left.object.Name):match("(%d+)$")) or 0
              local rightNumber = tonumber(tostring(right.object.Name):match("(%d+)$")) or 0
              return leftNumber < rightNumber
          end)
          state.buttons = buttons
      end
      -- A stale/hidden StarRiddles container must not pause fishing.  Only
      -- claim the macro when the wheel actually has clickable sign targets.
      if #state.buttons == 0 then return false end
      if now < state.nextClickAt then return true end

      local sequence = macroCallbacks.stellarwaveSequence(root)
      local scannedSignature = table.concat(sequence, "|")
      if #sequence == 0 and state.sequenceLocked then
          -- All ordered entries have their completion bar, or the riddle
          -- container was cleared after the last click.  Drop stale state so
          -- the next fishing minigame can be scanned from the beginning.
          state.sequence = {}
          state.sequenceKey = ""
          state.sequenceLocked = false
          state.nextIndex = 1
          state.lastActiveKey = nil
          state.nextClickAt = now + 0.20
          display("STELLARWAVE COMPLETE")
          return true
      end
      if #sequence > 0 and not state.sequenceLocked
          and scannedSignature ~= state.completedSequenceKey then
          state.sequenceKey = scannedSignature
          state.sequence = sequence
          state.sequenceLocked = true
          state.nextIndex = 1
          state.lastActiveKey = nil
      end
      if state.sequenceLocked and #state.sequence > 0 then
          if state.nextIndex > #state.sequence then
              state.nextClickAt = now + 0.45
              state.completedSequenceKey = state.sequenceKey
              state.sequence = {}
              state.sequenceKey = ""
              state.sequenceLocked = false
              state.nextIndex = 1
              display("STELLARWAVE COMPLETE")
              return true
          end
          local targetKey = state.sequence[state.nextIndex]
          local target
          for _, entry in ipairs(state.buttons) do
              if entry.key == targetKey or entry.imageKey == targetKey then
                  target = entry.object
                  break
              end
          end
          if target and macroCallbacks.stellarwaveClick(target) then
              state.nextIndex = state.nextIndex + 1
              state.nextClickAt = now + state.clickGap
              display(string.format("STELLARWAVE %d/%d", state.nextIndex - 1, #state.sequence))
          end
          return true
      end

      -- Never guess by cycling the wheel.  Until an ordered sequence is
      -- present, keep the cursor still and wait for the live sequence scan.
      display("STELLARWAVE SCANNING")
      return true
  end

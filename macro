  local function add(kind, x, y, baseOpacity)
      local d = Drawing.new(kind)
      d.Visible = true
      d.ZIndex = #drawings + 1
      local opacity = baseOpacity
      if opacity == nil then opacity = 1 end
      d.Transparency = opacity
      drawings[#drawings + 1] = d
      layout[#layout + 1] = {
          d = d,
          x = x,
          y = y,
          opacity = opacity,
      }
      return d
  end

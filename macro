  fishEsp.distance = function(a, b)
      local prev = {}
      for j = 0, #b do prev[j] = j end
      for i = 1, #a do
          local cur = {[0] = i}
          for j = 1, #b do
              cur[j] = math.min(cur[j - 1] + 1, prev[j] + 1,
                  prev[j - 1] + (a:sub(i, i) == b:sub(j, j) and 0 or 1))
          end
          prev = cur
      end
      return prev[#b]
  end

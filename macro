  fishEsp.searchAll = function(now)
      if fishEsp.searchText ~= fishEsp.text then
          fishEsp.searchText = fishEsp.text
          fishEsp.queries, fishEsp.scan = {}, nil
          fishEsp.retryAt = 0
          local seen = {}
          for value in fishEsp.text:gmatch("[^,;]+") do
              local query = fishEsp.normalize(value):sub(1, 64)
              if query ~= "" and not seen[query] and #fishEsp.queries < 8 then
                  seen[query] = true
                  fishEsp.queries[#fishEsp.queries + 1] = query
              end
          end
          fishEsp.setTargets({})
      end
      if not fishEsp.queries or #fishEsp.queries == 0 then
          fishEsp.status.Text = "Enter fish names"
          return
      end
      local character = player.Character
      local root = character and character:FindFirstChild("HumanoidRootPart")
      if not root then return end
      local origin = root.Position
      if now >= (fishEsp.nextAreaCheck or 0) then
          fishEsp.nextAreaCheck = now + 5
          local active = W:FindFirstChild("active")
          local roaming = active and active:FindFirstChild("roamingFish")
          local moved = fishEsp.areaOrigin and (origin - fishEsp.areaOrigin).Magnitude >= 250
          if roaming ~= fishEsp.areaFolder or moved then
              fishEsp.scan = nil
              fishEsp.areaFolder, fishEsp.areaOrigin = roaming, origin
          elseif not fishEsp.areaOrigin then
              fishEsp.areaOrigin = origin
          end
      end
      if not fishEsp.scan then
          if now < (fishEsp.retryAt or 0) then return end
          local active = W:FindFirstChild("active")
          local roaming = active and active:FindFirstChild("roamingFish")
          if not roaming then
              fishEsp.status.Text = "Waiting for live fish"
              fishEsp.retryAt = now + 5
              return
          end
          fishEsp.scan = {
              queue = {{object = roaming}}, index = 1, targets = {},
              seen = {}, names = {}, root = roaming,
          }
      end
      local scan = fishEsp.scan
      for step = 1, (panelInputCaptured or dragging) and 1 or 4 do
          local item = scan.queue[scan.index]
          if not item then
              fishEsp.setTargets(scan.targets)
              fishEsp.status.Text = #scan.targets .. " fish | refresh 5s"
              fishEsp.scan = nil
              fishEsp.retryAt = now + 5
              return
          end
          scan.queue[scan.index] = false
          scan.index = scan.index + 1
          local object = item.object
          local ok, err = pcall(function()
              if not object.Parent then return end
              local class = object.ClassName
              local isPart = class == "Part" or class == "MeshPart" or class == "UnionOperation"
              local container = class == "Model" or class == "Folder"
              if not container and not isPart then return end
              local name = object.Name
              local owner, ownerName = item.owner, item.ownerName
              local part
              if isPart then
                  part = object
              elseif class == "Model" then
                  part = object.PrimaryPart or object:FindFirstChild("Hitbox")
                      or object:FindFirstChild("Center")
              end
              local inRange = not part or (part.Position - origin).Magnitude <= 1000
              if not container and not inRange then return end
              local matches = scan.names[name]
              if class == "Folder" or not inRange then matches = false end
              if matches == nil then
                  matches = false
                  local normalized = fishEsp.normalize(name)
                  for _, query in ipairs(fishEsp.queries) do
                      if normalized == query or (#query >= 3 and normalized:find(query, 1, true)) then
                          matches = true
                          break
                      end
                      if #query >= 3 and #normalized <= 64 then
                          local limit = math.min(2, math.max(1, math.floor(#query * 0.25)))
                          if math.abs(#normalized - #query) <= limit
                              and fishEsp.distance(query, normalized) <= limit then
                              matches = true
                              break
                          end
                      end
                  end
                  scan.names[name] = matches
              end
              if matches and not owner and (class == "Model" or isPart) then
                  owner, ownerName = object, name
              end
              if part and owner and not scan.seen[owner] and #scan.targets < 64 then
                  local position = part.Position
                  if (position - origin).Magnitude <= 1000 then
                      scan.seen[owner] = true
                      scan.targets[#scan.targets + 1] = {
                          model = owner, part = part, name = ownerName, fixedPart = true,
                      }
                      fishEsp.liveSeen = fishEsp.liveSeen or {}
                      if not fishEsp.liveSeen[owner] and #fishEsp.targets < 64 then
                          fishEsp.liveSeen[owner] = true
                          fishEsp.targets[#fishEsp.targets + 1] = scan.targets[#scan.targets]
                      end
                  end
              end
              if container then
                  local children = object:GetChildren()
                  for i, child in ipairs(children) do
                      scan.queue[#scan.queue + 1] = {
                          object = child, owner = owner, ownerName = ownerName,
                      }
                      if i % 16 == 0 then
                          task.wait(0.01)
                          if not alive or not fishEsp.enabled or fishEsp.scan ~= scan then return end
                      end
                  end
              end
          end)
          if not ok then
              fishEsp.lastScanError = tostring(err)
          end
          task.wait(0.001)
          if not alive or not fishEsp.enabled or fishEsp.scan ~= scan then return end
      end
  end
  fishEsp.update = function(now)
      if not fishEsp.enabled then return end
      local targets = fishEsp.targets
      if #targets == 0 then return end
      local character = player.Character
      local root = character and character:FindFirstChild("HumanoidRootPart")
      if not root then
          for _, drawing in ipairs(fishEsp.drawings) do drawing.Visible = false end
          return
      end
      local origin = root.Position
      local activeTargets = {}
      for _, entry in ipairs(targets) do
          local keep = false
          pcall(function()
              keep = entry.model.Parent and entry.part.Parent
                  and (entry.part.Position - origin).Magnitude <= 1000
          end)
          if keep then activeTargets[#activeTargets + 1] = entry end
      end
      if #activeTargets ~= #targets then
          fishEsp.targets = activeTargets
          targets = activeTargets
          fishEsp.renderIndex = 0
          for i = #activeTargets + 1, #fishEsp.drawings do
              fishEsp.drawings[i].Visible = false
          end
      end
      if #targets == 0 then return end
      for step = 1, math.min(4, #targets) do
          fishEsp.renderIndex = ((fishEsp.renderIndex or 0) % #targets) + 1
          local index = fishEsp.renderIndex
          local entry = targets[index]
          local drawing = fishEsp.drawings[index]
          local ok = pcall(function()
              if not entry.part.Parent or not entry.model.Parent then
                  if drawing then drawing.Visible = false end
                  return
              end
              local position = entry.part.Position
              local distance = (position - origin).Magnitude
              if distance > 1000 then
                  if drawing then drawing.Visible = false end
                  return
              end
              local point, visible = WorldToScreen(position)
              if not point or not visible then
                  if drawing then drawing.Visible = false end
                  return
              end
              while #fishEsp.drawings < index do fishEsp.makeDrawing() end
              drawing = fishEsp.drawings[index]
              if now >= (entry.nextText or 0) or drawing.Text == "" then
                  drawing.Text = entry.name:sub(1, 40) .. "  |  " .. math.floor(distance + 0.5) .. " studs"
                  entry.nextText = now + 0.25
              end
              drawing.Position = Vector2.new(point.X, point.Y - 10)
              drawing.Visible = true
          end)
          if not ok and drawing then drawing.Visible = false end
      end
  end

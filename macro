      teleportWindow.bg.Size = Vector2.new(PANEL_W * uiScale, dropdownHeight)
      teleportWindow.border.Position = Vector2.new(dropdownX, dropdownY)
      teleportWindow.border.Size = Vector2.new(PANEL_W * uiScale, dropdownHeight)

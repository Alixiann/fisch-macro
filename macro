      local elapsed = now - totemMenu.startupIntro.started
      local fadeIn = math.clamp(elapsed / 0.65, 0, 1)
      local fadeOut = math.clamp((2.30 - elapsed) / 0.65, 0, 1)
      totemMenu.startupIntro.amount = math.min(fadeIn, fadeOut)
      local camera = W:FindFirstChildOfClass("Camera")
      local viewport = camera and camera.ViewportSize
      if viewport then
          local centerX, centerY = viewport.X / 2, viewport.Y / 2
          totemMenu.startupIntro.circle.Position = Vector2.new(centerX, centerY)
          totemMenu.startupIntro.circleOutline.Position = Vector2.new(centerX, centerY)
          totemMenu.startupIntro.title.Position = Vector2.new(centerX, centerY - 28)
          totemMenu.startupIntro.line.From = Vector2.new(centerX - 118, centerY + 8)
          totemMenu.startupIntro.line.To = Vector2.new(centerX + 118, centerY + 8)
          totemMenu.startupIntro.byline.Position = Vector2.new(centerX, centerY + 17)
      end
      totemMenu.startupIntro.circle.Color = Color3.new(
          1 + (C.bg.R - 1) * fadeIn,
          1 + (C.bg.G - 1) * fadeIn,
          1 + (C.bg.B - 1) * fadeIn
      )
      totemMenu.startupIntro.title.Color = Color3.new(
          1 + (C.pink.R - 1) * fadeIn,
          1 + (C.pink.G - 1) * fadeIn,
          1 + (C.pink.B - 1) * fadeIn
      )
      totemMenu.startupIntro.byline.Color = Color3.new(
          1 + (C.muted.R - 1) * fadeIn,
          1 + (C.muted.G - 1) * fadeIn,
          1 + (C.muted.B - 1) * fadeIn
      )
      for _, drawing in ipairs(totemMenu.startupIntro.drawings) do
          drawing.Transparency = 1 - totemMenu.startupIntro.amount
          drawing.Visible = true
      end
      if elapsed >= 3.30 then
          totemMenu.startupIntro.active = false
          shown = true
          fadeAmount = 0
          fadeLastTime = now
          for _, drawing in ipairs(totemMenu.startupIntro.drawings) do
              drawing.Visible = false
          end
      end

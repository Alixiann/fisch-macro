local function trackReel(bar,fish,playerbar,now)
    local f,b,width
    local ok=pcall(function()
        local origin,size=bar.AbsolutePosition,bar.AbsoluteSize
        local fp,fs=fish.AbsolutePosition,fish.AbsoluteSize
        local bp,bs=playerbar.AbsolutePosition,playerbar.AbsoluteSize
        if origin and size and fp and fs and bp and bs
            and size.X>0 and fs.X>0 and bs.X>0 then
            f=(fp.X+fs.X*.5-origin.X)/size.X
            b=(bp.X+bs.X*.5-origin.X)/size.X
            width=bs.X/size.X
        end
    end)
    if not ok or not (f and b and width) or width<=0 or width>1.1
        or f~=f or b~=b or f<-.1 or f>1.1 or b<-.1 or b>1.1 then
        setMacroMouse(false)
        resetMacroTracking()
        setMacroStatus("Tracking - waiting for valid reel positions")
        return false
    end

    f=math.clamp(f,0,1)
    b=math.clamp(b,0,1)
    local hadPrevious=lastTrackTime~=nil
    local dt=hadPrevious and now-lastTrackTime or 0
    if dt>0 and dt<=.15 and lastFish and lastBar then
        local fishDelta=f-lastFish
        local barDelta=b-lastBar
        local rawFish=math.clamp(fishDelta/dt,-1.5,1.5)
        local rawBar=math.clamp(barDelta/dt,-1.5,1.5)
        if rawFish*fishVelocity<0 then fishVelocity=rawFish end
        fishVelocity+=(rawFish-fishVelocity)*(1-math.exp(-dt/.045))
        barVelocity+=(rawBar-barVelocity)*(1-math.exp(-dt/.035))
    else
        fishVelocity,barVelocity=0,0
    end
    lastFish,lastBar,lastTrackTime=f,b,now

    -- Fisch uses held left mouse for right and release for left. Keep the
    -- prediction short so a fast fish cannot make the bar run to an edge.
    local lead=math.clamp(.035+math.abs(fishVelocity)*.018,.035,.065)
    local target=math.clamp(f+fishVelocity*lead,0,1)
    local error=target-b
    local score=error*5+fishVelocity-barVelocity*.65
    local deadband=.025
    local desired=macroMouseDown
    if score>deadband then
        desired=true
    elseif score< -deadband then
        desired=false
    end
    if math.abs(error)>.16 then desired=error>0 end

    -- Prevent direction chatter, while still correcting at up to 40 changes/s.
    if desired~=macroMouseDown and now-macroLastDirectionChangeAt<.025 then
        desired=macroMouseDown
    end
    local inputOk=setMacroMouse(desired)
    if not inputOk then
        setMacroStatus(desired and "Tracker input failed - right" or "Tracker input failed - left")
    else
        setMacroStatus(desired and "Tracking - pressing right" or "Tracking - releasing left")
    end
    return inputOk
end

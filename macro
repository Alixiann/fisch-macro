local harpoonCache={harpoonAt=0,harpoon=nil,harpoonX=nil,harpoonY=nil,harpoonId=nil}
local harpoonAimReadyAt,harpoonAimId=0,nil
  local HARPOON_SCAN_INTERVAL = 0.02
  local HARPOON_AIM_DELAY = 0.08
  local harpoonClickedButtons = {}
  local function activeHarpoonPullButton()
      local cache = harpoonCache
      local now = tick()
      if now < cache.harpoonAt then
          return cache.harpoon, cache.harpoonX, cache.harpoonY, cache.harpoonId
      end
      cache.harpoonAt = now + HARPOON_SCAN_INTERVAL
      cache.harpoon, cache.harpoonX, cache.harpoonY, cache.harpoonId = nil, nil, nil, nil
      local currentGui = player:FindFirstChildOfClass("PlayerGui")
      if not currentGui then return nil end
      local minigame = currentGui:FindFirstChild("harpoonMinigame")
          or currentGui:FindFirstChild("HarpoonMinigame")
          or currentGui:FindFirstChild("HarpoonGunMobile")
      if not minigame then
          for id in pairs(harpoonClickedButtons) do harpoonClickedButtons[id] = nil end
          return nil
      end
      local safezone = minigame and (minigame:FindFirstChild("safezone")
          or minigame:FindFirstChild("container"))
      if not safezone then return nil end

      -- Live pull circles are direct safezone children. The similarly named
      -- entries under buttonTemplates are hidden clones and must be ignored.
      local seenButtons = {}
      local nextButton, nextX, nextY, nextId
      for _, button in ipairs(safezone:GetChildren()) do
          if button.ClassName == "ImageButton"
              and tostring(button.Name):lower() == "pull" then
              local buttonId
              pcall(function() buttonId = tostring(button.Address) end)
              if not buttonId or buttonId == "nil" then
                  buttonId = tostring(button:GetFullName())
                      .. ":" .. tostring(button.AbsolutePosition.X)
                      .. ":" .. tostring(button.AbsolutePosition.Y)
              end
              seenButtons[buttonId] = true
              local title = button:FindFirstChild("title")
              local titleText = ""
              pcall(function() titleText = tostring(title and title.Text or "") end)
              local normalized = titleText:upper():gsub("[^%a]", "")
              if normalized:sub(1, 4) == "PULL"
                  and not harpoonClickedButtons[buttonId]
                  and not nextButton then
                      local position, size, titlePosition
                      pcall(function()
                          position = button.AbsolutePosition
                          size = button.AbsoluteSize
                          titlePosition = title and title.AbsolutePosition
                      end)
                      if position then
                          local x, y
                          if size and size.X > 8 and size.Y > 8 then
                              x, y = position.X + size.X / 2, position.Y + size.Y / 2
                          elseif titlePosition then
                              -- Matcha returns a zero AbsoluteSize for these
                              -- live buttons; use the moving title as fallback.
                              x, y = titlePosition.X + 16, titlePosition.Y + 8
                          else
                              x, y = position.X + 24, position.Y + 24
                          end
                          nextButton, nextX, nextY, nextId = button, x, y, buttonId
                      end
              end
          end
      end
      -- A clicked circle stays in the GUI briefly. Keep its ID blocked while
      -- present, then release the ID so a later circle can reuse that address.
      for id in pairs(harpoonClickedButtons) do
          if not seenButtons[id] then harpoonClickedButtons[id] = nil end
      end
      cache.harpoon, cache.harpoonX, cache.harpoonY, cache.harpoonId =
          nextButton, nextX, nextY, nextId
      return nextButton, nextX, nextY, nextId
  end

  local function moveMouseFast(x, y)
      if type(mousemoveabs) == "function" then
          return pcall(mousemoveabs, x, y)
      elseif type(setcursorpos) == "function" then
          return pcall(setcursorpos, x, y)
      elseif type(mousemoverel) == "function" then
          local cx, cy = cursor.X, cursor.Y
          if type(cx) == "number" and type(cy) == "number" then
              return pcall(mousemoverel, x - cx, y - cy)
          end
      end
      return false
  end


          y = math.clamp(y, 0, math.max(0, viewport.Y - drawH))
          dropdownX = math.clamp(dropdownX, 0, math.max(0, viewport.X - drawW))
          dropdownY = math.clamp(dropdownY, 0, math.max(0, viewport.Y - dropdownHeight))
      end
      panelX, panelY = x, y
      teleportWindow.x, teleportWindow.y = dropdownX, dropdownY
      lastPanelX, lastPanelY = x, y

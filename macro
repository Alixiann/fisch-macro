  local function writeTeleport(root, pos, offset, repeats)
      local target = CFrame.new(
          pos.X + (offset[1] or 0),
          pos.Y + (offset[2] or 0),
          pos.Z + (offset[3] or 0)
      )
      local ok, err = pcall(function() root.CFrame = target end)
      if not ok then return false, err end
      if repeats and repeats > 0 then
          task.spawn(function()
              for _ = 1, repeats do
                  if not alive or not root.Parent then return end
                  pcall(function() root.CFrame = target end)
                  task.wait(0.05)
              end
          end)
      end
      return true
  end
  local function teleportNpc(row)
      prepareTeleport()
      local root = characterRoot(npcStatus)
      if not root then return end
      local pos, live
      if row.skipNpc then
          pos = row.pos and Vector3.new(row.pos[1], row.pos[2], row.pos[3])
          live = false
      else
          local ok
          ok, pos = pcall(findNpcPosition, row)
          if not ok then pos = nil end
          live = pos ~= nil
          if not pos and row.pos then
              pos = Vector3.new(row.pos[1], row.pos[2], row.pos[3])
          end
      end
      if not pos then
          setNpcStatus(row.name .. ": not loaded")
          return
      end
      local moved, err = writeTeleport(root, pos, {
          0, row.exactPosition and 0 or 2, row.exactPosition and 0 or 4
      }, 6)
      if not moved then
          setNpcStatus("Teleport write failed")
          warn("NPC teleport: " .. tostring(err))
          return
      end
      setNpcStatus(row.name .. (live and ": moved" or ": map location"))
  end

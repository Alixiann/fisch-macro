  local function updateDrag(focused)
      local value = ismouse2pressed()
      local down = value == true or (type(value) == "number" and value ~= 0)
      local x, y = cursor.X, cursor.Y
      local dropdownHeight = math.max(32,
          npcMenuOpen
              and (islandMenu.top + 32 + 221 * islandMenu.anim - 388)
              or (autoTotem.open and 212 or 32)) * uiScale
      local inDropdown = focused and shown and (npcMenuOpen or autoTotem.open)

  local function activeShakeButton()
      local cache = totemMenu.buttonCache
      local now = tick()
      if now < cache.shakeAt then return cache.shake end
      cache.shakeAt = now + 0.15
      local currentGui = player:FindFirstChildOfClass("PlayerGui")
      local shakeGui = currentGui and (currentGui:FindFirstChild("shakeui")
          or currentGui:FindFirstChild("ShakeUI")
          or currentGui:FindFirstChild("ShakeMinigame"))
      local broadSearch = shakeGui == nil
      if not shakeGui then shakeGui = currentGui end
      if broadSearch then cache.shakeAt = now + 0.50 end
      if not shakeGui then cache.shake = nil; return nil end
      local found
      for _, object in ipairs(shakeGui:GetDescendants()) do
          local class = object.ClassName
          if class == "GuiButton" or class == "TextButton"
              or class == "ImageButton" or class == "TextLabel" then
              local okText, text = pcall(function() return object.Text end)
              if okText and type(text) == "string"
                  and text:lower():find("shake", 1, true) then
                  local visible, node = true, object
                  while node and node ~= shakeGui do
                      local okVisible, value = pcall(function() return node.Visible end)
                      if okVisible and value == false then
                          visible = false
                          break
                      end
                      node = node.Parent
                  end
                  if visible then
                      node = object
                      while node and node ~= shakeGui do
                          local nodeClass = node.ClassName
                          if nodeClass == "GuiButton" or nodeClass == "TextButton"
                              or nodeClass == "ImageButton" then
                              found = node
                              break
                          end
                          node = node.Parent
                      end
                      if not found and (class == "GuiButton"
                          or class == "TextButton" or class == "ImageButton") then
                          found = object
                      end
                  end
              end
          end
          if found then break end
      end
      cache.shake = found
      return found
  end
  local HARPOON_SCAN_INTERVAL = 0.02
  local HARPOON_AIM_DELAY = 0.08
  local harpoonClickedButtons = {}
  local function activeHarpoonPullButton()
      local cache = totemMenu.buttonCache
      local now = tick()
      if now < cache.harpoonAt then
          return cache.harpoon, cache.harpoonX, cache.harpoonY, cache.harpoonId
      end
      cache.harpoonAt = now + HARPOON_SCAN_INTERVAL
      cache.harpoon, cache.harpoonX, cache.harpoonY, cache.harpoonId = nil, nil, nil, nil
      local currentGui = player:FindFirstChildOfClass("PlayerGui")
      if not currentGui then return nil end
      local minigame = currentGui:FindFirstChild("harpoonMinigame")
          or currentGui:FindFirstChild("HarpoonMinigame")
          or currentGui:FindFirstChild("HarpoonGunMobile")
      if not minigame then
          for id in pairs(harpoonClickedButtons) do harpoonClickedButtons[id] = nil end
          return nil
      end
      local safezone = minigame and (minigame:FindFirstChild("safezone")
          or minigame:FindFirstChild("container"))
      if not safezone then return nil end

      -- Live pull circles are direct safezone children. The similarly named
      -- entries under buttonTemplates are hidden clones and must be ignored.
      local seenButtons = {}
      local nextButton, nextX, nextY, nextId
      for _, button in ipairs(safezone:GetChildren()) do
          if button.ClassName == "ImageButton"
              and tostring(button.Name):lower() == "pull" then
              local buttonId
              pcall(function() buttonId = tostring(button.Address) end)
              if not buttonId or buttonId == "nil" then
                  buttonId = tostring(button:GetFullName())
                      .. ":" .. tostring(button.AbsolutePosition.X)
                      .. ":" .. tostring(button.AbsolutePosition.Y)
              end
              seenButtons[buttonId] = true
              local title = button:FindFirstChild("title")
              local titleText = ""
              pcall(function() titleText = tostring(title and title.Text or "") end)
              local normalized = titleText:upper():gsub("[^%a]", "")
              if normalized:sub(1, 4) == "PULL"
                  and not harpoonClickedButtons[buttonId]
                  and not nextButton then
                      local position, size, titlePosition
                      pcall(function()
                          position = button.AbsolutePosition
                          size = button.AbsoluteSize
                          titlePosition = title and title.AbsolutePosition
                      end)
                      if position then
                          local x, y
                          if size and size.X > 8 and size.Y > 8 then
                              x, y = position.X + size.X / 2, position.Y + size.Y / 2
                          elseif titlePosition then
                              -- Matcha returns a zero AbsoluteSize for these
                              -- live buttons; use the moving title as fallback.
                              x, y = titlePosition.X + 16, titlePosition.Y + 8
                          else
                              x, y = position.X + 24, position.Y + 24
                          end
                          nextButton, nextX, nextY, nextId = button, x, y, buttonId
                      end
              end
          end
      end
      -- A clicked circle stays in the GUI briefly. Keep its ID blocked while
      -- present, then release the ID so a later circle can reuse that address.
      for id in pairs(harpoonClickedButtons) do
          if not seenButtons[id] then harpoonClickedButtons[id] = nil end
      end
      cache.harpoon, cache.harpoonX, cache.harpoonY, cache.harpoonId =
          nextButton, nextX, nextY, nextId
      return nextButton, nextX, nextY, nextId
  end
  local function moveMouseFast(x, y)
      if type(mousemoveabs) == "function" then
          return pcall(mousemoveabs, x, y)
      elseif type(setcursorpos) == "function" then
          return pcall(setcursorpos, x, y)
      elseif type(mousemoverel) == "function" then
          local cx, cy = cursor.X, cursor.Y
          if type(cx) == "number" and type(cy) == "number" then
              return pcall(mousemoverel, x - cx, y - cy)
          end
      end
      return false
  end
  local lastShakeX, lastShakeY
  local lastShakeMoveAt = tick()
  local harpoonAimReadyAt = 0
  local harpoonAimId
  task.spawn(function()
      while alive do
          if (enabled or harpoonPullEnabled) and not panelInputCaptured then
              local isHarpoonButton = harpoonPullEnabled
              local button, buttonX, buttonY, buttonId
              if isHarpoonButton then
                  button, buttonX, buttonY, buttonId = activeHarpoonPullButton()
              elseif enabled then
                  button = activeShakeButton()
              end
              if button then
                  if not isHarpoonButton then
                      pcall(function()
                          local p, size = button.AbsolutePosition, button.AbsoluteSize
                          if p and size and size.X > 8 and size.Y > 8 then
                              buttonX, buttonY = p.X + size.X / 2, p.Y + size.Y / 2
                          end
                      end)
                  end
                  if buttonX then
                      moveMouseFast(buttonX, buttonY)
                      if isHarpoonButton then
                          if buttonId ~= harpoonAimId then
                              harpoonAimId = buttonId
                              harpoonAimReadyAt = tick() + HARPOON_AIM_DELAY
                          elseif tick() >= harpoonAimReadyAt then
                              -- Recheck the live list at click time; circles
                              -- can move or be replaced during the aim wait.
                              totemMenu.buttonCache.harpoonAt = 0
                              local _, freshX, freshY, freshId =
                                  activeHarpoonPullButton()
                              if freshId ~= buttonId then
                                  harpoonAimId = nil
                                  harpoonAimReadyAt = 0
                              else
                                  moveMouseFast(freshX, freshY)
                                  local clickOk = pcall(mouse1click)
                                  if clickOk then
                                      harpoonClickedButtons[buttonId] = true
                                      harpoonAimId = nil
                                      harpoonAimReadyAt = 0
                                      local cache = totemMenu.buttonCache
                                      cache.harpoon, cache.harpoonX, cache.harpoonY, cache.harpoonId = nil, nil, nil, nil
                                      cache.harpoonAt = 0
                                  else
                                      harpoonAimReadyAt = tick() + 0.20
                                  end
                              end
                          end
                      else
                          pcall(mouse1press)
                          pcall(mouse1release)
                          pcall(function()
                              VirtualInputManager:SendMouseButtonEvent(
                                  buttonX, buttonY, 0, true, player, 0)
                              VirtualInputManager:SendMouseButtonEvent(
                                  buttonX, buttonY, 0, false, player, 0)
                          end)
                      end
                      if not isHarpoonButton then
                          if not lastShakeX
                              or math.abs(buttonX - lastShakeX) > 2
                              or math.abs(buttonY - lastShakeY) > 2 then
                              lastShakeX, lastShakeY = buttonX, buttonY
                              lastShakeMoveAt = tick()
                          elseif tick() - lastShakeMoveAt >= 1 then
                              moveMouseFast(buttonX + 3, buttonY)
                              task.wait(0.02)
                              moveMouseFast(buttonX, buttonY)
                              lastShakeMoveAt = tick()
                          end
                      end
                  end
                  task.wait(isHarpoonButton and HARPOON_SCAN_INTERVAL or 0.06)
              else
                  if harpoonPullEnabled then
                      harpoonAimId = nil
                      harpoonAimReadyAt = 0
                  end
                  task.wait(harpoonPullEnabled and HARPOON_SCAN_INTERVAL or 0.03)
              end
          else
              if harpoonPullEnabled then
                  activeHarpoonPullButton()
                  harpoonAimId = nil
                  harpoonAimReadyAt = 0
                  task.wait(HARPOON_SCAN_INTERVAL)
              else
                  task.wait(0.50)
              end
          end
      end
  end)

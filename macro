  local function updatePanelInput(focused)
      local x, y = cursor.X, cursor.Y
      local inside = focused and shown and lastPanelX and lastPanelY
          and type(x) == "number" and type(y) == "number"
          and x >= lastPanelX and x <= lastPanelX + PANEL_W * uiScale
          and y >= lastPanelY and y <= lastPanelY + PANEL_H * uiScale
      local capture = focused and shown and (inside or dragging)
      if capture and not panelInputCaptured then
          -- Release synthetic inputs before blocking game input.
          mouse(false)
          releaseKey()
          if navigationReleaseAt then
              keyrelease(0xDC)
              navigationReleaseAt = nil
          end
          navigationWanted = navigationOn
          setrobloxinput(false)
          panelInputCaptured = true
      elseif not capture then
          releasePanelInput()
      end

      local value = ismouse1pressed()
      local down = value == true or (type(value) == "number" and value ~= 0)
      local localX = inside and (x - lastPanelX) / uiScale or 0
      local localY = inside and (y - lastPanelY) / uiScale or 0
      updateCustomGpsTyping()
      if customGpsEditing and inside and down and not leftWasDown
          and not (localY >= 397 and localY < 425) then
          customGpsEditing = false
          pcall(setrobloxinput, true)
      end

      if inside and not dragging and down and not leftWasDown
          and localX >= 10 and localX <= 147
          and localY >= 311 and localY <= 337 then
          castMode = castMode == "Perfect" and "Instant" or "Perfect"
          castModeText.Text = castMode .. " cast"
          castModeText.Color = castMode == "Instant" and C.instantOff or C.green
          lastDisplay = ""
      end
      if inside and not dragging and down and not leftWasDown
          and localY >= 5 and localY <= 35 then
          if localX >= PANEL_W - 58 and localX <= PANEL_W - 34 then
              resizePanel(-UI_SCALE_STEP)
          elseif localX >= PANEL_W - 33 and localX <= PANEL_W - 5 then
              resizePanel(UI_SCALE_STEP)
          end
      end

      if inside and not dragging and down and not leftWasDown
          and localX >= 10 and localX <= 147
          and localY >= 287 and localY <= 313 then
          toggleInstant()
      end
      if inside and not dragging and down and not leftWasDown
          and localX >= 10 and localX <= 147
          and localY >= 263 and localY <= 285 then
          toggleMacro()
      end
      if inside and not dragging and down and not leftWasDown then
          if localY >= 357 and localY <= 387 then
              npcMenuOpen = not npcMenuOpen
              if npcMenuOpen then
                  totemMenu.open, islandMenu.open = false, false
              else
                  totemMenu.open, islandMenu.open = false, false
                  customGpsEditing = false
              end
              layoutTeleportMenus()
          elseif npcMenuOpen and localY >= 397 and localY < 425 then
              customGpsEditing = true
              customGpsKeys = {}
              pcall(setrobloxinput, false)
              updateCustomGpsDisplay()
          elseif npcMenuOpen and localY >= 452 and localY < 480 then
              npcSubOpen = not npcSubOpen
              layoutTeleportMenus()
          elseif npcMenuOpen and localY >= 425 and localY < 452 then
              teleportCustomGps()
          elseif npcMenuOpen and localY >= islandMenu.top and localY < islandMenu.top + 32 then
              islandMenu.open = not islandMenu.open
              if islandMenu.open then
                  totemMenu.open = false
                  totemMenu.anim = 0
              end
              layoutTeleportMenus()
          elseif npcMenuOpen and localY >= totemMenu.top and localY < totemMenu.top + 32 then
              totemMenu.open = not totemMenu.open
              if totemMenu.open then
                  islandMenu.open = false
                  islandMenu.anim = 0
              end
              layoutTeleportMenus()
          elseif npcMenuOpen and islandMenu.open then
              local offset = localY - islandMenu.top
              if offset >= 198 and offset < 224 then
                  local pages = math.ceil(#islandMenu.rows / islandMenu.pageSize)
                  if localX < 95 then islandMenu.page = math.max(1, islandMenu.page - 1)
                  elseif localX > 190 then islandMenu.page = math.min(pages, islandMenu.page + 1) end
                  layoutTeleportMenus()
              elseif offset >= 32 and offset < 32 + islandMenu.pageSize * 27 then
                  local slot = math.floor((offset - 32) / 27) + 1
                  local row = islandMenu.rows[(islandMenu.page - 1) * islandMenu.pageSize + slot]
                  if row then teleportIsland(row) end
              end
          elseif npcMenuOpen and totemMenu.open then
              local offset = localY - totemMenu.top
              if offset >= 198 and offset < 224 then
                  local pages = math.ceil(#totemMenu.rows / totemMenu.pageSize)
                  if localX < 95 then totemMenu.page = math.max(1, totemMenu.page - 1)
                  elseif localX > 190 then totemMenu.page = math.min(pages, totemMenu.page + 1) end
                  layoutTeleportMenus()
              elseif offset >= 32 and offset < 32 + totemMenu.pageSize * 27 then
                  local slot = math.floor((offset - 32) / 27) + 1
                  local row = totemMenu.rows[(totemMenu.page - 1) * totemMenu.pageSize + slot]
                  if row then teleportTotem(row) end
              end
          elseif npcMenuOpen and x >= lastPanelX + 12 and x <= lastPanelX + PANEL_W - 12 then
              for _, row in ipairs(npcRows) do
                  if localY >= row.y and localY < row.y + 27 then
                      teleportNpc(row)
                      break
                  end
              end
          end
      end
      leftWasDown = down
  end

  local function numberValue(parent, name)
      local child = parent and parent:FindFirstChild(name)
      if not child then return nil end

      local class = child.ClassName
      if class ~= "NumberValue" and class ~= "IntValue" then
          return nil
      end

      local value = child.Value

      if type(value) == "number"
          and value == value
          and math.abs(value) < math.huge then
          return value
      end

      return nil
  end

  local function equippedRod()
      local character = player.Character
      if not character then return nil end

      -- Equipped tools live in Character; backpack rods are not equipped.
      for _, tool in ipairs(character:GetChildren()) do
          if tool.ClassName == "Tool" then
              local events = tool:FindFirstChild("events")
              local cast = events and events:FindFirstChild("castAsync")
              if cast and cast.ClassName == "RemoteFunction" then
                  return tool
              end
          end
      end

      return nil
  end


  local function cleanText(value)
      if type(value) ~= "string" then return nil end
      value = value:gsub("<[bB][rR]%s*/?>", "\n")
      value = value:gsub("<[^>]*>", "")
      value = value:gsub("&times;", "x")
      value = value:gsub("Ã—", "x")
      value = value:gsub("&nbsp;", " ")
      value = value:gsub("&amp;", "&")
      value = value:gsub("\r", "")
      value = value:match("^%s*(.-)%s*$")
      local lower = value:lower()
      if value == ""
          or lower == "none"
          or lower == "nil"
          or lower == "false"
          or lower == "weather status"
          or lower == "failed to fetch text" then
          return nil
      end
      if value:find("[%z\1-\8\11\12\14-\31]")
          or value:find("ï¿½", 1, true) then
          return nil
      end
      return value
  end
  local function normalized(value)

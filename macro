  local function readEnvironment(now)
      gui = player and player:FindFirstChild("PlayerGui") or gui
      world = (W and W:FindFirstChild("world"))
          or (RS and RS:FindFirstChild("world")) or nil
      local events, descriptions = {}, {}
      local seenEvents, seenDescriptions = {}, {}
      local serverNow = now
      local okClock, valueClock = pcall(function()
          return os.time()
      end)
      if okClock and type(valueClock) == "number" then
          serverNow = valueClock
      end
      local okServerNow, valueServerNow = pcall(function()
          return W:GetServerTimeNow()
      end)
      if okServerNow and type(valueServerNow) == "number" then
          serverNow = valueServerNow
      end
      local function describe(value)
          value = cleanText(value)
          if not value then return end
          local key = value:lower()
          if not seenDescriptions[key] then
              seenDescriptions[key] = true
              descriptions[#descriptions + 1] = value
          end
      end
      local function include(value)
          value = cleanText(value)
          if not value then return end
          describe(value)
          local title = value:match("[^\n]+") or value
          local titleLower = title:lower()
          if titleLower:find("name unavailable", 1, true) then return end
          local key = title:lower():gsub("%s+", " ")
          for line in value:gmatch("[^\n]+") do
              local lower = line:lower()
              if line ~= title and not lower:find("remaining", 1, true)
                  and (line:find("%", 1, true)
                      or line:find("×", 1, true)
                      or lower:match("%d+%s*x")
                      or lower:find("luck", 1, true)
                      or lower:find("chance", 1, true)
                      or lower:find("speed", 1, true)
                      or lower:find("mutation", 1, true)) then
                  local parsedModifier = line:gsub("×", "x")
                  if not eventModifiers[key] or #parsedModifier > #eventModifiers[key] then
                      eventModifiers[key] = parsedModifier
                  end
                  local fallbackModifier = eventFallbackModifiers[key]
                  if fallbackModifier and (not eventModifiers[key] or #fallbackModifier > #eventModifiers[key]) then
                      eventModifiers[key] = fallbackModifier
                  end
                  break
              end
          end
          local minutes, seconds = value:match("(%d+):(%d%d)%s*[rR]emaining")
          if minutes and seconds then
              local remaining = tonumber(minutes) * 60 + tonumber(seconds)
              local deadline = eventDeadlines[key]
              local candidate = now + remaining
              -- HUD labels can lag each other by a fraction of a second.
              -- Keep the cached deadline through small jitter instead of
              -- repeatedly snapping the countdown backward and forward.
              if not deadline or deadline <= now
                  or math.abs(candidate - deadline) > 2 then
                  eventDeadlines[key] = candidate
              end
          end
          local index = seenEvents[key]
          if not index then
              events[#events + 1] = value
              seenEvents[key] = #events
          elseif #value > #events[index] then
              events[index] = value
          end
      end
      local function includeKnown(name, endTime)
          name = cleanText(name)
          if not name then return end
          local key = name:lower():gsub("%s+", " ")
          local text = name
           local modifier = eventFallbackModifiers[key] or eventModifiers[key]
          if modifier then
              text = text .. "\n" .. modifier
          end
          local remaining
          local directDuration
          if type(endTime) == "number" and endTime >= 100000000 then
              remaining = math.max(0, endTime - serverNow)
          elseif type(endTime) == "number" and endTime > 0 then
              directDuration = endTime > 1000 and endTime / 1000 or endTime
          end
          if remaining and remaining <= 0 then remaining = nil end
          if not remaining and eventDeadlines[key] then
              local cachedRemaining = eventDeadlines[key] - now
              if cachedRemaining > 0 then
                  remaining = cachedRemaining
              else
                  eventDeadlines[key] = nil
              end
          end
          if not remaining then
              local duration = directDuration or eventDurations[key]
              if duration then
                  if not eventStartTimes[key]
                      or now - eventStartTimes[key] >= duration then
                      eventStartTimes[key] = now
                  end
                  remaining = math.max(0, duration - (now - eventStartTimes[key]))
              end
          end
          if remaining then
              text = text .. string.format(
                  "\n%02d:%02d remaining",
                  math.floor(remaining / 60), math.floor(remaining % 60)
              )
          end
          include(text)
      end
      local hud = gui and gui:FindFirstChild("hud")
      local safe = hud and hud:FindFirstChild("safezone")
      local statuses = safe and safe:FindFirstChild("worldstatuses")
      if statuses then
          for _, entry in ipairs(statuses:GetChildren()) do
              local name = entry.Name:lower()
              if not name:find("cycle", 1, true)
                  and not name:find("season", 1, true) then
                  for _, item in ipairs(entry:GetDescendants()) do
                      if item.ClassName == "TextLabel" then
                          local text = cleanText(item:GetAttribute("CurrentText"))
                              or cleanText(item.Text)
                          if text and item.Name:lower():find("tooltip", 1, true) then
                              include(text)
                              if name == "event1" then
                                  local cachedTitle = text:match("[^\n]+") or ""
                                  if not cachedTitle:lower():find("name unavailable", 1, true) then
                                      eventStatusCacheText = text
                                      eventStatusCacheName = cachedTitle
                                  end
                              end
                          elseif text and name:find("event", 1, true) then
                              local lower = text:lower()
                              if lower ~= "weather status"
                                  and not lower:find("failed to fetch", 1, true) then
                                  include(text)
                              end
                          end
                      end
                  end
              end
          end
      end
       for _, name in ipairs({
           "weather", "clientWeather", "event", "admin_event", "AdminEventText"
       }) do
          local slot = world and world:FindFirstChild(name)
          if slot then
               if slot.ClassName == "StringValue" then
                   local slotName = cleanText(slot.Value)
                   if name == "event" then
                       if slotName then
                           if slotName:lower() == "none" then
                               eventStatusCacheText = nil
                               eventStatusCacheName = nil
                           else
                               if eventStatusCacheName
                                   and eventStatusCacheName:lower() ~= slotName:lower() then
                                   eventStatusCacheText = nil
                                   eventStatusCacheName = nil
                               end
                               includeKnown(slotName, slot:GetAttribute("EndTime"))
                           end
                       elseif eventStatusCacheText then
                           include(eventStatusCacheText)
                       end
                   else
                       includeKnown(slotName, slot:GetAttribute("EndTime"))
                   end
               end
              for _, group in ipairs(slot:GetDescendants()) do
                  if group.ClassName == "StringValue" then
                      include(group.Value)
                  end
              end
           end
       end
       if not eventIconColors._loadAttempted then
           eventIconColors._loadAttempted = true
           pcall(function()
               local shared = RS and RS:FindFirstChild("shared")
               local modules = shared and shared:FindFirstChild("modules")
               local weatherModule = modules and modules:FindFirstChild("SharedWeather")
               local library = modules and modules:FindFirstChild("library")
               local weatherData = library and library:FindFirstChild("weathers")
               local localizedData = library and library:FindFirstChild("localizedevents")
               if weatherModule and not weatherApi then weatherApi = require(weatherModule) end
               if weatherData and not weatherLibrary then weatherLibrary = require(weatherData) end
               if localizedData and not localizedEventLibrary then
                   localizedEventLibrary = require(localizedData)
               end
           end)
       end
       if not eventIconColorsLoaded and (weatherLibrary or localizedEventLibrary) then
           if weatherLibrary then
               for weatherName, config in pairs(weatherLibrary) do
                   if type(config) == "table" then
                       local color = config.IconColor or config.ChatColor
                       if color then eventIconColors[weatherName:lower()] = color end
                   end
               end
           end
           if localizedEventLibrary then
               for attribute, displayName in pairs(localizedEventNames) do
                   local config = localizedEventLibrary[attribute]
                   if config and config.IconColor then
                       eventIconColors[displayName:lower()] = config.IconColor
                   end
               end
           end
           eventIconColorsLoaded = true
       end
       if weatherApi and type(weatherApi.GetAllActive) == "function" then
           local okWeather, activeWeather = pcall(function()
               return weatherApi.GetAllActive()
           end)
           if okWeather and type(activeWeather) == "table" then
               for _, weatherName in ipairs(activeWeather) do
                   local config = weatherLibrary and weatherLibrary[weatherName]
                   local displayName = config and (config.DisplayName or config.Name) or weatherName
                   includeKnown(displayName)
               end
           end
       end
       for attribute, displayName in pairs(localizedEventNames) do
           local activeUntil = W:GetAttribute(attribute)
           local numericUntil = tonumber(activeUntil)
           if numericUntil and numericUntil >= 100000000 then
               if numericUntil > serverNow then
                   includeKnown(displayName, numericUntil)
               end
           elseif numericUntil and numericUntil > 0 then
               eventDurations[displayName:lower()] = numericUntil > 1000
                   and numericUntil / 1000 or numericUntil
               includeKnown(displayName)
           elseif activeUntil == true
               or (type(activeUntil) == "string"
                   and activeUntil:lower() == "true") then
               includeKnown(displayName)
           end
       end
       for _, entry in ipairs({
          {"meteor_active", "Meteor"},
          {"blizzard_active", "Blizzard"},
          {"absolute_darkness_active", "Absolute Darkness"},
          {"absoluteDarkness_active", "Absolute Darkness"},
          {"absoluteDarknessActive", "Absolute Darkness"},
      }) do
          local flag = world and world:FindFirstChild(entry[1])
          if flag and flag.ClassName == "BoolValue" and flag.Value == true then
              include(entry[2])
          end
      end
      if world then
          for _, flag in ipairs(world:GetDescendants()) do
              if flag.ClassName == "BoolValue" and flag.Value == true then
                  local n = flag.Name:lower():gsub("[^%w]", "")
                  if n:find("meteor", 1, true) and n:find("active", 1, true) then
                      include("Meteor")
                  elseif n:find("absolute", 1, true)
                      and n:find("dark", 1, true)
                      and n:find("active", 1, true) then
                      include("Absolute Darkness")
                  end
              end
          end
      end
      local boostsGui = gui and gui:FindFirstChild("CurrentServerBoosts")
      local boosts = boostsGui and boostsGui:FindFirstChild("boosts")
      if boosts then
          for _, entry in ipairs(boosts:GetChildren()) do
              local title = entry:FindFirstChild("Title")
              local amount = entry:FindFirstChild("length")
              local titleValue = title
                  and title.ClassName == "TextLabel"
                  and cleanText(title.Text)
              local amountValue = amount
                  and amount.ClassName == "TextLabel"
                  and cleanText(amount.Text)
              if titleValue and amountValue then
                  local boostText = titleValue .. " " .. amountValue
                  describe(boostText)
                  local boostName = titleValue:lower()
                  if boostName:find("meteor", 1, true)
                      or boostName:find("absolute", 1, true)
                      or boostName:find("darkness", 1, true)
                      or boostName:find("event", 1, true) then
                      include(boostText)
                  end
              end
              for _, item in ipairs(entry:GetDescendants()) do
                  if item.ClassName == "TextLabel" then
                      local value = cleanText(item.Text)
                      if value then
                          local lower = value:lower()
                          if lower:find("luck", 1, true)
                              or lower:find("shiny", 1, true)
                              or lower:find("sparkling", 1, true)
                              or lower:find("mutation", 1, true) then
                              describe(value)
                          end
                      end
                  end
              end
          end
      end
      local function priority(value)
          local n = value:lower()
          if n:find("admin", 1, true)
              or n:find("aurora", 1, true)
              or n:find("tropical", 1, true)
              or n:find("rainbow", 1, true) then
              return 1
          end
          if n:find("shiny", 1, true)
              or n:find("sparkling", 1, true)
              or n:find("mutation", 1, true) then
              return 2
          end
          return 3
      end
      table.sort(events, function(a, b)
          local pa, pb = priority(a), priority(b)
          if pa == pb then return a < b end
          return pa < pb
      end)
      return events, descriptions
  end
  local function advertisedLuck(descriptions, scope)
      local found
      for _, description in ipairs(descriptions) do
          local text = normalized(description)
          local raw =
              text:match(scope .. "%s+luck%s*[:=]?%s*x%s*(%d+%.?%d*)")
              or text:match(scope .. "%s+luck%s*[:=]?%s*(%d+%.?%d*)%s*x")
              or text:match("(%d+%.?%d*)%s*x%s+" .. scope .. "%s+luck")
          local value = raw and tonumber(raw)
          if value and value > 0 then
              if found and found ~= value then
                  return nil, true
              end
              found = value
          end
      end
      return found, false
  end
  local function wrapEventTitle(value)
      local limit = 38
      if #value <= limit then return value, nil end
      local split = value:find(" | ", 1, true)
      if split then
          local first = value:sub(1, split - 1)
          local second = value:sub(split + 3)
          if #second > limit then
              second = second:sub(1, limit - 3) .. "..."
          end
          return first, second
      end
      local cut = value:sub(1, limit):match("^.*%s")
      cut = cut and #cut or limit
      local first = value:sub(1, cut):gsub("%s+$", "")
      local second = value:sub(cut + 1):gsub("^%s+", "")
      if #second > limit then
          second = second:sub(1, limit - 3) .. "..."
      end
      return first, second ~= "" and second or nil
  end
  environmentText = function(events, now)
      if #events == 0 then
          eventHeading.Text = "WEATHER / EVENTS"
          for _, line in ipairs(weatherLines) do line.Text = "" end
          return "Unavailable"
      end
      local perPage = 6
      local pages = math.ceil(#events / perPage)
      local page = math.floor(now / EVENT_SCROLL_SECONDS) % pages
      local first = page * perPage + 1
      local last = math.min(first + perPage - 1, #events)
      eventHeading.Text = string.format(
          "WEATHER / EVENTS  %d ACTIVE%s", #events,
          pages > 1 and string.format("  %d/%d", page + 1, pages) or ""
      )
      for _, line in ipairs(weatherLines) do line.Text = "" end
      local rowSlot = 1
      for i = first, last do
          if rowSlot > #weatherLines then break end
          local title = events[i]:match("^[^\n]+") or events[i]
           local key = title:lower():gsub("%s+", " ")
           local deadline = eventDeadlines[key]
           local timer = deadline and string.format(
               "%02d:%02d remaining",
               math.floor(math.max(0, deadline - now) / 60),
               math.floor(math.max(0, deadline - now) % 60)
           ) or events[i]:match("(%d%d?:%d%d)")
               or events[i]:match("(%d+)%s*[sS]ec")
               or events[i]:match("(%d+)%s*[mM]in")
           if timer and not title:find(timer, 1, true) then
               title = title .. "  [" .. timer .. "]"
           end
           local modifier = eventFallbackModifiers[key] or eventModifiers[key]
           if modifier then title = title:gsub("%s+$", "") .. "  |  " .. modifier end
           local firstTitle, secondTitle = wrapEventTitle(title)
           local row = weatherLines[rowSlot]
           row.Text = firstTitle
           local name = title:lower()
           local rowColor = eventIconColors[key] or C.white
           for _, mapping in ipairs(C.eventColors) do
               if name:find(mapping[1], 1, true) then
                   rowColor = mapping[2]
                   break
               end
           end
           row.Color = rowColor
           if secondTitle and rowSlot < #weatherLines then
               local secondRow = weatherLines[rowSlot + 1]
               secondRow.Text = secondTitle
               secondRow.Color = rowColor
               rowSlot = rowSlot + 2
           else
               rowSlot = rowSlot + 1
           end
       end
      return ""
  end
  local function refreshStats(now)
      updateSession(now)
      positionPanel()
      local seconds = math.floor(elapsed)
      timerText.Text = string.format(
          "Runtime   %02d:%02d:%02d",
          math.floor(seconds / 3600),
          math.floor(seconds / 60) % 60,
          seconds % 60
      )
      fishText.Text = "Caught    "
          .. (sessionCaught and tostring(sessionCaught) or "--")
      local clock, isDaytime = serverClock()
      local period = isDaytime and "Daytime" or "Nighttime"
      clockText.Text = "Server    " .. clock .. " (" .. period .. ")"
      local blend = 1 - math.exp(-0.5 * 5)
      clockDayBlend = clockDayBlend
          + ((isDaytime and 1 or 0) - clockDayBlend) * blend
      local nightText = Color3.fromRGB(210, 230, 255)
      local dayText = Color3.fromRGB(255, 235, 80)
      clockText.Color = Color3.new(
          nightText.R + (dayText.R - nightText.R) * clockDayBlend,
          nightText.G + (dayText.G - nightText.G) * clockDayBlend,
          nightText.B + (dayText.B - nightText.B) * clockDayBlend
      )
      if now >= nextEnvironment then
           cachedEvents, cachedDescriptions = readEnvironment(now)
          nextEnvironment = now + ENVIRONMENT_INTERVAL
      end
      local serverLuck, serverConflict =
          advertisedLuck(cachedDescriptions, "server")
      local globalLuck, globalConflict =
          advertisedLuck(cachedDescriptions, "global")
      if not serverLuck and not serverConflict then
          serverLuck = numberValue(world, "luck_Server")
      end
      if not globalLuck and not globalConflict then
          globalLuck = numberValue(world, "luck_Luck")
      end
      environmentText(cachedEvents, now)
  end
  autoTotem.setStatus = function(text, color)
      if not autoTotem.status then ensureAutoTotemDrawings() end
      autoTotem.status.Text = "Status: " .. tostring(text)
      autoTotem.status.Color = color or C.muted
  end

  autoTotem.detectSlot9 = function()
      gui = player and player:FindFirstChild("PlayerGui") or gui
      local backpackGui = gui and gui:FindFirstChild("backpack")
      local hotbar = backpackGui and backpackGui:FindFirstChild("hotbar")
      if not hotbar then return nil, nil end
      local entries = {}
      for _, item in ipairs(hotbar:GetChildren()) do
          if item.ClassName == "ImageButton" then
              local label = item:FindFirstChild("ItemName", true)
              local text
              if label then pcall(function() text = label.Text end) end
              if type(text) == "string" and text ~= "" then
                  local position
                  pcall(function() position = item.AbsolutePosition end)
                  entries[#entries + 1] = {
                      text = text,
                      x = position and position.X or (#entries + 1),
                  }
              end
          end
      end
      table.sort(entries, function(left, right) return left.x < right.x end)
      local slot9 = entries[9]
      if not slot9 then return nil, nil end
      local normalized = slot9.text:lower():gsub("[^%w]", "")
      if normalized:find("aurora", 1, true) or normalized:find("lucktotem", 1, true) then
          return "luck", slot9.text
      end
      if normalized:find("tropicalsun", 1, true) then
          return "tropical", slot9.text
      end
      if normalized:find("rainbow", 1, true) then
          return "rainbow", slot9.text
      end
      return "unsupported", slot9.text
  end

  autoTotem.scanTarget = function(targetKind, forceRefresh)
      local now = tick()
      if forceRefresh or now >= nextEnvironment then
          cachedEvents, cachedDescriptions = readEnvironment(now)
          nextEnvironment = now + ENVIRONMENT_INTERVAL
      end
      if not targetKind then return false end
      for _, value in ipairs(cachedEvents or {}) do
          local title = tostring(value):match("^[^\n]+") or tostring(value)
          local normalized = title:lower():gsub("[^%w]", "")
          if (targetKind == "any" and (normalized == "auroraborealis"
                  or normalized:find("rainbow", 1, true)))
              or (targetKind == "luck" and normalized == "auroraborealis")
              or (targetKind == "tropical" and normalized:find("tropicalsun", 1, true))
              or (targetKind == "rainbow" and normalized:find("rainbow", 1, true)) then
              return true
          end
      end
      return false
  end

  autoTotem.macroReady = function(generation)
      return alive and autoTotem.enabled
          and not autoTotem.restartRequired
          and (generation == nil or generation == autoTotem.generation)
  end

  autoTotem.resetAttemptTimer = function()
      autoTotem.attemptStartedAt = nil
  end

  autoTotem.startAttemptTimer = function()
      if not autoTotem.attemptStartedAt then
          autoTotem.attemptStartedAt = tick()
      end
  end

  autoTotem.tripFailsafe = function(generation)
      if generation ~= nil and generation ~= autoTotem.generation then return false end
      autoTotem.generation = autoTotem.generation + 1
      autoTotem.enabled = false
      autoTotem.busy = false
      autoTotem.pending = false
      autoTotem.startupCheckPending = false
      autoTotem.startupConfirmed = false
      autoTotem.restartRequired = true
      autoTotem.nextScan = 0
      autoTotem.resetAttemptTimer()
      ensureAutoTotemDrawings()
      autoTotem.toggleText.Text = "Auto Totem OFF"
      autoTotem.toggleText.Color = C.instantOff
      autoTotem.helpText.Text = "Re-enable, then restart macro"
      autoTotem.setStatus("Failsafe - Auto Totem OFF; fishing resumed", C.red)
      mouse(false)
      releaseKey()
      setNavigation(false)
      releaseAt, idleSince = nil, nil
      recoveryStage = 0
      resetTracking()
      equipPending = equippedRod() == nil
      equipReadyAt = 0
      nextCast = tick()
      return true
  end

  autoTotem.checkFailsafe = function(generation)
      if autoTotem.attemptStartedAt
          and tick() - autoTotem.attemptStartedAt >= autoTotem.failsafeSeconds then
          return autoTotem.tripFailsafe(generation)
      end
      return false
  end

  autoTotem.waitGuarded = function(seconds, generation)
      local deadline = tick() + seconds
      while tick() < deadline do
          if not autoTotem.macroReady(generation) then return false, "stopped" end
          if autoTotem.checkFailsafe(generation) then return false, "failsafe" end
          task.wait(math.min(0.25, math.max(0, deadline - tick())))
      end
      if autoTotem.checkFailsafe(generation) then return false, "failsafe" end
      return autoTotem.macroReady(generation), "done"
  end

  autoTotem.fishingCycleActive = function()
      gui = player and player:FindFirstChild("PlayerGui") or gui
      local reel = gui and gui:FindFirstChild("reel")
      local bar = reel and reel:FindFirstChild("bar")
      local fish = bar and bar:FindFirstChild("fish")
      local playerbar = bar and bar:FindFirstChild("playerbar")
      return (reel and bar and fish and playerbar)
          or activeShakeButton() ~= nil
          or held or releaseAt ~= nil
  end

  autoTotem.tapSlot = function(keyCode, generation)
      if not autoTotem.macroReady(generation)
          or autoTotem.checkFailsafe(generation) then return false end
      keypress(keyCode)
      task.wait(KEY_HOLD)
      keyrelease(keyCode)
      task.wait(0.30)
      return autoTotem.macroReady(generation)
          and not autoTotem.checkFailsafe(generation)
  end

  autoTotem.clickOnce = function(generation)
      if not autoTotem.macroReady(generation)
          or autoTotem.checkFailsafe(generation) then return false end
      pcall(mouse1click)
      task.wait(0.20)
      return autoTotem.macroReady(generation)
          and not autoTotem.checkFailsafe(generation)
  end

  autoTotem.finish = function(message, color, delay, generation, confirmed)
      if generation ~= nil and generation ~= autoTotem.generation then return end
      autoTotem.busy = false
      autoTotem.pending = false
      autoTotem.startupCheckPending = false
      if confirmed then
          autoTotem.startupConfirmed = true
          autoTotem.resetAttemptTimer()
      end
      autoTotem.nextScan = tick() + (delay or autoTotem.scanInterval)
      if not autoTotem.enabled then
          autoTotem.setStatus("Waiting", C.muted)
      else
          if enabled then
              equipPending = equippedRod() == nil
              equipReadyAt = 0
              nextCast = tick() + 0.40
          end
          autoTotem.setStatus(message, color)
      end
  end

  autoTotem.run = function()
      if autoTotem.busy or not autoTotem.enabled then return end
      local targetKind, targetName
      if autoTotem.luckEnabled then
          targetKind, targetName = autoTotem.detectSlot9()
      else
          targetKind, targetName = "any", "Aurora/Rainbow"
      end
      autoTotem.targetKind, autoTotem.targetName = targetKind, targetName
      if not targetKind or targetKind == "unsupported" then
          autoTotem.pending = false
          autoTotem.setStatus(
              targetName and ("Unsupported 9th-slot totem: " .. targetName)
                  or "Put a Luck, Tropical Sun, or Rainbow Totem in slot 9",
              C.red)
          return
      end
      if autoTotem.scanTarget(targetKind, true) then
          autoTotem.pending = false
          autoTotem.startupCheckPending = false
          autoTotem.startupConfirmed = true
          autoTotem.resetAttemptTimer()
          autoTotem.nextScan = tick() + autoTotem.scanInterval
          autoTotem.setStatus(targetName .. " is active", C.instantOn)
          return
      end
      autoTotem.startAttemptTimer()
      if autoTotem.checkFailsafe() then return end
      autoTotem.busy = true
      autoTotem.pending = false
      local generation = autoTotem.generation
      mouse(false)
      releaseKey()
      setNavigation(false)
      releaseAt, idleSince = nil, nil
      recoveryStage = 0
      resetTracking()
      task.wait(0.15)
      if not autoTotem.macroReady(generation) then
          autoTotem.finish("Stopped", C.muted, nil, generation)
          return
      end
      if not autoTotem.luckEnabled then
          -- Sundial-only mode: never equip or click the luck totem in slot 9.
          -- Check before every Sundial so an already-active event is left
          -- alone, and keep fishing normally until that event ends.
          for _ = 1, 5 do
              if autoTotem.scanTarget(targetKind, true) then
                  autoTotem.finish(targetName .. " is active - fishing resumed",
                      C.instantOn, nil, generation, true)
                  return
              end
              autoTotem.setStatus("Sundial mode - using Sundial Totem...", C.yellow)
              if not autoTotem.tapSlot(0x38, generation)
                  or not autoTotem.clickOnce(generation) then
                  autoTotem.finish("Stopped", C.muted, nil, generation)
                  return
              end
              local waited, reason = autoTotem.waitGuarded(10, generation)
              if not waited then
                  if reason ~= "failsafe" then
                      autoTotem.finish("Stopped", C.muted, nil, generation)
                  end
                  return
              end
          end
          autoTotem.finish(targetName .. " not detected - Sundial retrying",
              C.yellow, 1, generation)
          return
      end
      local clock, isDaytime = serverClock()
      if clock == "?" then
          autoTotem.finish("Server time unavailable - retrying in 60s", C.red, nil, generation)
          return
      end
      local needsDaytime = targetKind == "tropical" or targetKind == "rainbow"
      if isDaytime ~= needsDaytime then
          autoTotem.setStatus(
              (needsDaytime and "Nighttime" or "Daytime")
                  .. " - using Sundial Totem...", C.yellow)
          if not autoTotem.tapSlot(0x38, generation) -- 8th hotbar slot: Sundial Totem
              or not autoTotem.clickOnce(generation) then
              autoTotem.finish("Stopped", C.muted, nil, generation)
              return
          end
          autoTotem.setStatus(
              "Waiting 10s for " .. (needsDaytime and "daytime" or "nighttime") .. "...",
              C.cyan)
          local waited, reason = autoTotem.waitGuarded(10, generation)
          if not waited then
              if reason ~= "failsafe" then autoTotem.finish("Stopped", C.muted, nil, generation) end
              return
          end
          local clock, stillDaytime = serverClock()
          if clock == "?" then
              autoTotem.finish("Server time unavailable - retrying in 60s", C.red, nil, generation)
              return
          end
          if stillDaytime ~= needsDaytime then
              autoTotem.finish(
                  "Time did not change to " .. (needsDaytime and "day" or "night")
                      .. " - retrying in 60s", C.red, nil, generation)
              return
          end
          if autoTotem.scanTarget(targetKind, true) then
              autoTotem.finish(targetName .. " appeared after Sundial - fishing resumed",
                  C.instantOn, nil, generation, true)
              return
          end
      end
      autoTotem.setStatus("Using " .. targetName .. "...", C.yellow)
      if not autoTotem.tapSlot(0x39, generation) -- 9th hotbar slot: selected luck totem
          or not autoTotem.clickOnce(generation) then
          autoTotem.finish("Stopped", C.muted, nil, generation)
          return
      end
      autoTotem.setStatus("Confirming " .. targetName .. "...", C.cyan)
      local waited, reason = autoTotem.waitGuarded(5, generation)
      if not waited then
          if reason ~= "failsafe" then autoTotem.finish("Stopped", C.muted, nil, generation) end
          return
      end
      if autoTotem.scanTarget(targetKind, true) then
          autoTotem.finish(targetName .. " confirmed - fishing resumed",
              C.instantOn, nil, generation, true)
          return
      end
      autoTotem.setStatus("Not detected - clicking " .. targetName .. " again...", C.yellow)
      if not autoTotem.clickOnce(generation) then
          autoTotem.finish("Stopped", C.muted, nil, generation)
          return
      end
      local retry, retryReason = autoTotem.waitGuarded(5, generation)
      if not retry then
          if retryReason ~= "failsafe" then autoTotem.finish("Stopped", C.muted, nil, generation) end
          return
      end
      if autoTotem.scanTarget(targetKind, true) then
          autoTotem.finish(targetName .. " confirmed - fishing resumed",
              C.instantOn, nil, generation, true)
      else
          autoTotem.finish(targetName .. " not detected - retrying in 60s",
              C.red, nil, generation)
      end
  end

  autoTotem.poll = function()
      if not autoTotem.enabled or autoTotem.restartRequired
          or autoTotem.busy or not isrbxactive() or panelInputCaptured then return end
      local now = tick()
      if autoTotem.startupCheckPending or now >= autoTotem.nextScan then
          local detectedKind, detectedName
          if autoTotem.luckEnabled then
              detectedKind, detectedName = autoTotem.detectSlot9()
          else
              detectedKind, detectedName = "any", "Aurora/Rainbow"
          end
          autoTotem.targetKind, autoTotem.targetName = detectedKind, detectedName
          if not detectedKind or detectedKind == "unsupported" then
              autoTotem.pending = false
              autoTotem.startupCheckPending = false
              autoTotem.setStatus(
                  detectedName and ("Unsupported 9th-slot totem: " .. detectedName)
                      or "Put a Luck, Tropical Sun, or Rainbow Totem in slot 9",
                  C.red)
              return
          end
          local targetActive = autoTotem.scanTarget(detectedKind, true)
          autoTotem.nextScan = now + autoTotem.scanInterval
          if targetActive then
              autoTotem.pending = false
              autoTotem.startupCheckPending = false
              autoTotem.startupConfirmed = true
              autoTotem.resetAttemptTimer()
              autoTotem.setStatus(detectedName .. " is active - fishing ready", C.instantOn)
              return
          end
          autoTotem.pending = true
          autoTotem.setStatus(
              autoTotem.startupConfirmed and (detectedName .. " missing - waiting for safe break...")
                  or ("No " .. detectedName .. " - preparing totems before fishing..."), C.yellow)
      end
      if autoTotem.pending and (not autoTotem.startupConfirmed
          or autoTotem.startupCheckPending or not autoTotem.fishingCycleActive()) then
          autoTotem.run()
      end
  end


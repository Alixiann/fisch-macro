  local function moveMouseFast(x, y)
      if type(mousemoveabs) == "function" then
          return pcall(mousemoveabs, x, y)
      elseif type(setcursorpos) == "function" then
          return pcall(setcursorpos, x, y)
      elseif type(mousemoverel) == "function" then
          local cx, cy = cursor.X, cursor.Y
          if type(cx) == "number" and type(cy) == "number" then
              return pcall(mousemoverel, x - cx, y - cy)
          end
      end
      return false
  end
  local lastShakeX, lastShakeY
  local lastShakeMoveAt = tick()
  local harpoonNextClickAt = 0
  local harpoonReadyAt = 0
  task.spawn(function()
      while alive do
          if (enabled or harpoonPullEnabled) and not panelInputCaptured then
              local isHarpoonButton = harpoonPullEnabled
              local button = harpoonPullEnabled and activeHarpoonPullButton()
                  or (enabled and activeShakeButton())
              if button then
                  local buttonX, buttonY
                  local didClick = false
                  pcall(function()
                      local p, size = button.AbsolutePosition, button.AbsoluteSize
                      local x, y = p.X + size.X / 2, p.Y + size.Y / 2
                      buttonX, buttonY = x, y
                      moveMouseFast(x, y)
                      if isHarpoonButton then
                          task.wait(0.01)
                          moveMouseFast(x, y)
                          if tick() >= harpoonNextClickAt and harpoonReadyAt == 0 then
                              harpoonReadyAt = tick() + 0.1
                          end
                      end
                      if not isHarpoonButton
                          or (tick() >= harpoonNextClickAt and tick() >= harpoonReadyAt) then
                          didClick = true
                          if isHarpoonButton then
                              pcall(mouse1click)
                          else
                              pcall(mouse1press)
                              task.wait(0.02)
                              pcall(mouse1release)
                              VirtualInputManager:SendMouseButtonEvent(
                                  x, y, 0, true, player, 0)
                              VirtualInputManager:SendMouseButtonEvent(
                                  x, y, 0, false, player, 0)
                          end
                      end
                  end)
                  if buttonX then
                      if isHarpoonButton and didClick then
                          harpoonNextClickAt = tick() + 0.05
                          harpoonReadyAt = 0
                      end
                      if not lastShakeX
                          or math.abs(buttonX - lastShakeX) > 2
                          or math.abs(buttonY - lastShakeY) > 2 then
                          lastShakeX, lastShakeY = buttonX, buttonY
                          lastShakeMoveAt = tick()
                      elseif tick() - lastShakeMoveAt >= 1 then
                          moveMouseFast(buttonX + 3, buttonY)
                          task.wait(0.02)
                          moveMouseFast(buttonX, buttonY)
                          lastShakeMoveAt = tick()
                      end
                  end
                  task.wait(isHarpoonButton and 0.1 or 0.06)
              else
                  task.wait(0.03)
              end
          else
              task.wait(0.50)
          end
      end
  end)

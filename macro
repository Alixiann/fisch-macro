  local function activeShakeButton()
      local currentGui = player:FindFirstChildOfClass("PlayerGui")
      local shakeGui = currentGui and currentGui:FindFirstChild("shakeui")
      if not shakeGui then return nil end
      local function visibleInTree(object)
          local node = object
          while node and node ~= shakeGui do
              local ok, visible = pcall(function() return node.Visible end)
              if ok and visible == false then return false end
              node = node.Parent
          end
          return true
      end
      local function hasShakeText(object)
          local ok, value = pcall(function() return object.Text end)
          return ok and type(value) == "string"
              and value:lower():find("shake", 1, true) ~= nil
      end
      for _, object in ipairs(shakeGui:GetDescendants()) do
          if (object:IsA("GuiButton") or object:IsA("TextLabel"))
              and visibleInTree(object) and hasShakeText(object) then
              local node = object
              while node and node ~= shakeGui do
                  if node:IsA("GuiButton") then return node end
                  node = node.Parent
              end
              if object:IsA("GuiButton") then return object end
          end
      end
      return nil
  end
  local function activeHarpoonPullButton()
      local currentGui = player:FindFirstChildOfClass("PlayerGui")
      if not currentGui then return nil end
      local minigame = currentGui:FindFirstChild("harpoonMinigame")
      local safezone = minigame and minigame:FindFirstChild("safezone")
      if not safezone then return nil end
      local newest
      for _, object in ipairs(safezone:GetChildren()) do
          local objectName = tostring(object.Name):lower()
          if object.ClassName == "ImageButton" and objectName:find("pull", 1, true) then
              local ok, size = pcall(function() return object.AbsoluteSize end)
              if ok and size and size.X > 8 and size.Y > 8 then
                  local title = object:FindFirstChild("title")
                  local textOk, text = pcall(function() return title and title.Text end)
                  local normalized = textOk and type(text) == "string"
                      and text:upper():gsub("[^%a]", "") or ""
                  if normalized == "PULL" then
                      newest = object
                  end
              end
          end
      end
      return newest
  end

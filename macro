  local function teleportNpc(row)
      -- Stop casting before moving, including any held synthetic inputs.
      enabled, equipPending = false, false
      mouse(false)
      releaseKey()
      setNavigation(false)
      releaseAt, idleSince = nil, nil
      resetTracking()
      if _G.StopAuroraRoute then _G.StopAuroraRoute() end
      local character = player.Character
      local root = character and character:FindFirstChild("HumanoidRootPart")
      if not root then npcStatus.Text = "Waiting for your character"; return end
      local pos, live
      if row.skipNpc then
          pos = row.pos and Vector3.new(row.pos[1], row.pos[2], row.pos[3])
          live = false
      else
          local ok
          ok, pos = pcall(findNpcPosition, row)
          if not ok then pos = nil end
          live = pos ~= nil
          if not pos and row.pos then
              pos = Vector3.new(row.pos[1], row.pos[2], row.pos[3])
          end
      end
      if not pos then
          npcStatus.Text = row.name .. ": not loaded"
          return
      end
      local moved, err = pcall(function()
          root.CFrame = CFrame.new(
              pos.X,
              pos.Y + (row.exactPosition and 0 or 2),
              pos.Z + (row.exactPosition and 0 or 4)
          )
      end)
      if not moved then
          npcStatus.Text = "Teleport write failed"
          warn("NPC teleport: " .. tostring(err))
          return
      end
      task.spawn(function()
          for _ = 1, 6 do
              if not alive or not root or not root.Parent then return end
              pcall(function()
                  root.CFrame = CFrame.new(
                      pos.X,
                      pos.Y + (row.exactPosition and 0 or 2),
                      pos.Z + (row.exactPosition and 0 or 4)
                  )
              end)
              task.wait(0.05)
          end
      end)
      npcStatus.Text = row.name .. (live and ": moved" or ": map location")
  end


  rodSpeed.apply = function()
      if not rodSpeed.enabled or not rodSpeed.cache or instantEnabled then return end
      local value = tonumber(rodSpeed.text)
      if not value or value ~= value or math.abs(value) == math.huge then
          rodSpeed.status.Text = "enter a number"
          return
      end
      rodSpeed.value = value
      local ok, err = pcall(applygc, rodSpeed.cache, "progressefficiency", value)
      if not ok then
          rodSpeed.status.Text = "apply failed"
          warn("Rod speed stopped: " .. tostring(err))
      else

  local function positionPanel()
      local camera = W:FindFirstChildOfClass("Camera")
      local viewport = camera and camera.ViewportSize

      local drawW, drawH = PANEL_W * uiScale, PANEL_H * uiScale
      local x = panelX or (viewport
          and math.max(8, viewport.X - drawW - 18) or 900
      )
      local y = panelY or (viewport
          and math.max(8, (viewport.Y - drawH) / 2) or 260
      )

      if viewport then
          x = math.clamp(x, 0, math.max(0, viewport.X - drawW))
          y = math.clamp(y, 0, math.max(0, viewport.Y - drawH))
      end

      lastPanelX, lastPanelY = x, y

      if customGpsFallbackBox then
          local visible = shown and npcMenuOpen
          customGpsFallbackBox.Visible = visible
          customGpsFallbackText.Visible = visible
          customGpsFallbackButton.Visible = visible
      end

      for _, entry in ipairs(layout) do
          entry.d.Position = Vector2.new(x + entry.x * uiScale, y + entry.y * uiScale)
          local ok, size = pcall(function() return entry.d.Size end)
          if ok and size then
              if entry.baseSize == nil then
                  if type(size) == "number" then
                      entry.baseSize = size
                  elseif size.X and size.Y then
                      entry.baseSize = Vector2.new(size.X, size.Y)
                  end
              end
              if type(entry.baseSize) == "number" then
                  entry.d.Size = entry.baseSize * uiScale
              elseif entry.baseSize then
                  entry.d.Size = entry.baseSize * uiScale
              end
          end
      end
      border.Size = Vector2.new(drawW, drawH)
  end

  local function updateDrag(focused)
      local value = ismouse2pressed()
      local down = value == true or (type(value) == "number" and value ~= 0)
      local x, y = cursor.X, cursor.Y
      if not focused or not shown or type(x) ~= "number" or type(y) ~= "number" then
          dragging = false
      elseif down then
          if lastPanelX and lastPanelY
              and x >= lastPanelX and x <= lastPanelX + PANEL_W * uiScale
              and y >= lastPanelY and y <= lastPanelY + PANEL_H * uiScale then
              -- Keep Roblox from treating GUI dragging as camera orbit.
              pcall(setrobloxinput, false)
          end
          if not rightWasDown and lastPanelX and lastPanelY
              and x >= lastPanelX and x <= lastPanelX + PANEL_W * uiScale
              and y >= lastPanelY and y <= lastPanelY + PANEL_H * uiScale then
              dragging = true
              dragOffsetX, dragOffsetY = x - lastPanelX, y - lastPanelY
          end
          if dragging then
              panelX, panelY = x - dragOffsetX, y - dragOffsetY
              positionPanel()
          end
      else
          dragging = false
      end
      rightWasDown = down
  end

  local function updateFade(now)
      local dt = math.max(0, now - fadeLastTime)
      fadeLastTime = now
      borderPhase = (borderPhase + dt * 2.4) % (math.pi * 2)
      local pulse = (math.sin(borderPhase) + 1) / 2
      local edgeLevel = 120 + 135 * pulse
      local edgeColor = Color3.fromRGB(edgeLevel, 35, edgeLevel)
      border.Color = edgeColor
      accent.Color = edgeColor


      -- Smooth watermark loop: pink -> white -> pink.
      local watermarkPulse = (math.sin(borderPhase) + 1) / 2
      watermark.Color = Color3.new(
          C.pink.R + (C.white.R - C.pink.R) * watermarkPulse,
          C.pink.G + (C.white.G - C.pink.G) * watermarkPulse,
          C.pink.B + (C.white.B - C.pink.B) * watermarkPulse
      )

      local target = shown and 1 or 0

      if fadeAmount < target then
          fadeAmount = math.min(target, fadeAmount + dt / FADE_SECONDS)
      elseif fadeAmount > target then
          fadeAmount = math.max(target, fadeAmount - dt / FADE_SECONDS)
      end

      for _, entry in ipairs(layout) do
          local menuAlpha = 1

          if npcMenuDrawings[entry.d] then
              menuAlpha = npcMenuAnim
              if npcMenuDrawings[entry.d] >= 480 then
                  menuAlpha = menuAlpha * (npcSubOpen and 1 or 0)
              end
          elseif totemMenu.drawings[entry.d] then
              menuAlpha = totemMenu.anim
          elseif islandMenu.drawings[entry.d] then
              menuAlpha = islandMenu.anim
          elseif entry.d == totemMenu.title or entry.d == totemMenu.arrow
              or entry.d == islandMenu.title or entry.d == islandMenu.arrow then
              menuAlpha = npcMenuAnim
          elseif entry.d == menuBackdrop then
              menuAlpha = math.max(npcMenuAnim, totemMenu.anim)
          end

          entry.d.Transparency = entry.opacity * fadeAmount * menuAlpha
          entry.d.Visible = fadeAmount > 0.001 and menuAlpha > 0.001
      end
  end


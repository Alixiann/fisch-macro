local function normalizeName(value)
    return tostring(value or ""):lower():gsub("[^%w]","")
end
local function eventMatches(value,kind)
    local name=normalizeName(value)
    if kind=="any" then
        return name:find("aurora",1,true)~=nil or name:find("rainbow",1,true)~=nil
    elseif kind=="luck" then
        return name:find("aurora",1,true)~=nil
    elseif kind=="tropical" then
        return name:find("tropicalsun",1,true)~=nil
    elseif kind=="rainbow" then
        return name:find("rainbow",1,true)~=nil
    end
    return false
end
local function eventAttributeActive(value)
    if value==true or (type(value)=="string" and value:lower()=="true") then return true end
    local number=tonumber(value)
    if not number or number<=0 then return false end
    if number>=1000000000000 then number=number/1000 end
    if number>=100000000 then
        local ok,serverNow=pcall(function() return os.time() end)
        return ok and type(serverNow)=="number" and number>serverNow
    end
    return true
end
local function cleanEventText(value)
    if type(value)~="string" then return nil end
    value=value:gsub("<[^>]*>",""):gsub("&nbsp;"," "):gsub("&amp;","&")
        :gsub("\r",""):match("^%s*(.-)%s*$")
    local lower=value:lower()
    if value=="" or lower=="none" or lower=="nil" or lower=="false"
        or lower=="weather status" or lower:find("failed to fetch",1,true) then
        return nil
    end
    return value
end
local function detectSlot9()
    local pg=player and player:FindFirstChild("PlayerGui")
    local backpackGui=pg and pg:FindFirstChild("backpack")
    local hotbar=backpackGui and backpackGui:FindFirstChild("hotbar")
    if not hotbar then return nil,nil end
    local entries={}
    for _,item in ipairs(hotbar:GetChildren()) do
        if item.ClassName=="ImageButton" then
            local label=item:FindFirstChild("ItemName",true)
            local textValue
            if label then pcall(function() textValue=label.Text end) end
            if type(textValue)~="string" then textValue="" end
            local slot,position
            pcall(function()
                slot=tonumber(item:GetAttribute("Slot")) or tonumber(item:GetAttribute("slot"))
                    or tonumber(item.Name:match("%d+"))
                position=item.AbsolutePosition
            end)
            if textValue~="" or slot then
                entries[#entries+1]={text=textValue,slot=slot,item=item,
                    x=position and position.X or #entries+1}
            end
        end
    end
    table.sort(entries,function(a,b) return a.x<b.x end)
    local entry
    for _,candidate in ipairs(entries) do
        if candidate.slot==9 then entry=candidate; break end
    end
    entry=entry or entries[9]
    if not entry then return nil,nil end
    local name=normalizeName(entry.text)
    if name:find("aurora",1,true) or name:find("lucktotem",1,true) then
        return "luck",entry.text
    elseif name:find("tropicalsun",1,true) then
        return "tropical",entry.text
    elseif name:find("rainbow",1,true) then
        return "rainbow",entry.text
    end
    return "unsupported",entry.text
end
local function scanEventRoot(root,kind,found)
    if not root then return end
    local ok,children=pcall(function() return root:GetChildren() end)
    if not ok or type(children)~="table" then return end
    local queue,index,slice=children,1,tick()
    while index<=#queue do
        if not alive or not autoTotem.enabled then return end
        local object=queue[index]
        queue[index]=false
        index=index+1
        local readOk=pcall(function()
            local class=object.ClassName
            local objectName=normalizeName(object.Name)
            local related=objectName:find("weather",1,true)
                or objectName:find("event",1,true)
                or objectName:find("aurora",1,true)
                or objectName:find("tropical",1,true)
                or objectName:find("rainbow",1,true)
            if class=="StringValue" then
                local value=cleanEventText(object.Value)
                if value and eventMatches(value,kind) then found[#found+1]=value end
            elseif class=="BoolValue" and object.Value==true
                and eventMatches(object.Name,kind) then
                found[#found+1]=object.Name
            end
            if related then
                local attrs=object:GetAttributes()
                if type(attrs)=="table" then
                    for key,value in pairs(attrs) do
                        if type(key)=="number" and type(value)=="string" then
                            key,value=value,object:GetAttribute(value)
                        end
                        if eventAttributeActive(value) then
                            if eventMatches(key,kind) or eventMatches(object.Name,kind) then
                                found[#found+1]=tostring(key)
                            end
                        elseif type(value)=="string" then
                            local textValue=cleanEventText(value)
                            if textValue and eventMatches(textValue,kind) then
                                found[#found+1]=textValue
                            end
                        end
                    end
                end
            end
            for _,child in ipairs(object:GetChildren()) do queue[#queue+1]=child end
        end)
        if not readOk then end
        if tick()-slice>=.004 then
            task.wait()
            slice=tick()
        end
    end
end
local function scanTargetEvent(kind,force)
    local pg=player and player:FindFirstChild("PlayerGui")
    local world=(ReplicatedStorage and ReplicatedStorage:FindFirstChild("world"))
        or (Workspace and Workspace:FindFirstChild("world"))
    local eventValue=world and world:FindFirstChild("event")
    if eventValue and eventValue.ClassName=="StringValue" then
        local value
        pcall(function() value=cleanEventText(eventValue.Value) end)
        if value and eventMatches(value,kind) then return true end
    end
    local hud=pg and pg:FindFirstChild("hud")
    local safe=hud and hud:FindFirstChild("safezone")
    local statuses=safe and safe:FindFirstChild("worldstatuses")
    local eventEntry=statuses and statuses:FindFirstChild("event1")
    if eventEntry then
        local ok,items=pcall(function() return eventEntry:GetDescendants() end)
        if ok and type(items)=="table" then
            for _,item in ipairs(items) do
                if item.ClassName=="TextLabel" then
                    local value
                    pcall(function()
                        value=cleanEventText(item:GetAttribute("CurrentText")) or cleanEventText(item.Text)
                    end)
                    if value and eventMatches(value,kind) then return true end
                end
            end
        end
    end
    local now=tick()
    if force or now>=autoTotem.environmentAt then
        autoTotem.environmentAt=now+2
        autoTotem.environmentCache={}
        local roots={}
        local replicated=ReplicatedStorage and ReplicatedStorage:FindFirstChild("world")
        local live=Workspace and Workspace:FindFirstChild("world")
        if replicated then roots[#roots+1]=replicated end
        if live and live~=replicated then roots[#roots+1]=live end
        for _,root in ipairs(roots) do
            scanEventRoot(root,kind,autoTotem.environmentCache)
        end
        local okAttrs,workspaceAttrs=pcall(function() return Workspace:GetAttributes() end)
        if okAttrs and type(workspaceAttrs)=="table" then
            for key,value in pairs(workspaceAttrs) do
                if type(key)=="number" and type(value)=="string" then
                    key,value=value,Workspace:GetAttribute(value)
                end
                if eventAttributeActive(value) and eventMatches(key,kind) then
                    autoTotem.environmentCache[#autoTotem.environmentCache+1]=tostring(key)
                end
            end
        end
        if not sharedWeatherAttempted then
            sharedWeatherAttempted=true
            pcall(function()
                local shared=ReplicatedStorage and ReplicatedStorage:FindFirstChild("shared")
                local modules=shared and shared:FindFirstChild("modules")
                local module=modules and modules:FindFirstChild("SharedWeather")
                if module then sharedWeatherApi=require(module) end
            end)
        end
        if sharedWeatherApi and type(sharedWeatherApi.GetAllActive)=="function" then
            local okWeather,activeWeather=pcall(function()
                return sharedWeatherApi:GetAllActive()
            end)
            if not okWeather then
                okWeather,activeWeather=pcall(function()
                    return sharedWeatherApi.GetAllActive()
                end)
            end
            if okWeather and type(activeWeather)=="table" then
                for key,name in pairs(activeWeather) do
                    local value=type(name)=="string" and name or type(key)=="string" and key
                    if value and eventMatches(value,kind) then
                        autoTotem.environmentCache[#autoTotem.environmentCache+1]=value
                    end
                end
            end
        end
        local boosts=pg and pg:FindFirstChild("CurrentServerBoosts")
        if boosts then
            local list=boosts:FindFirstChild("boosts")
            if list then
                for _,entry in ipairs(list:GetChildren()) do
                    local title=entry:FindFirstChild("Title")
                    local value
                    if title and title.ClassName=="TextLabel" then
                        pcall(function() value=cleanEventText(title.Text) end)
                    end

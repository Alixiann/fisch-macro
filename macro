          npcMenuOpen
              and (islandMenu.top + 32 + 221 * islandMenu.anim - 388)
              or (autoTotem.open and 212 or 32)) * uiScale
      local dropdownX = teleportWindow.x or x
      local dropdownY = teleportWindow.y or (y + PANEL_H * uiScale + 8)

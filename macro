  fishEsp.update = function(now)
      if not fishEsp.enabled then return end
      local targets = fishEsp.targets
      if #targets == 0 then return end
      local character = player.Character
      local root = character and character:FindFirstChild("HumanoidRootPart")
      if not root then
          for _, drawing in ipairs(fishEsp.drawings) do drawing.Visible = false end
          return
      end
      local origin = root.Position
      local activeTargets = {}
      for _, entry in ipairs(targets) do
          local keep = false
          pcall(function()
                  keep = entry.model.Parent and entry.part.Parent
                      and (entry.part.Position - origin).Magnitude <= 670
          end)
          if keep then activeTargets[#activeTargets + 1] = entry end
      end
      if #activeTargets ~= #targets then
          fishEsp.targets = activeTargets
          targets = activeTargets
          fishEsp.renderIndex = 0
          for i = #activeTargets + 1, #fishEsp.drawings do
              fishEsp.drawings[i].Visible = false
          end
      end
      if #targets == 0 then return end
      for step = 1, math.min(4, #targets) do
          fishEsp.renderIndex = ((fishEsp.renderIndex or 0) % #targets) + 1
          local index = fishEsp.renderIndex
          local entry = targets[index]
          local drawing = fishEsp.drawings[index]
          local ok = pcall(function()
              if not entry.part.Parent or not entry.model.Parent then
                  if drawing then drawing.Visible = false end
                  return
              end
              local position = entry.part.Position
              local distance = (position - origin).Magnitude
               if distance > 670 then
                  if drawing then drawing.Visible = false end
                  return
              end
              local point, visible = WorldToScreen(position)
              if not point or not visible then
                  if drawing then drawing.Visible = false end
                  return
              end
              while #fishEsp.drawings < index do fishEsp.makeDrawing() end
              drawing = fishEsp.drawings[index]
              if now >= (entry.nextText or 0) or drawing.Text == "" then
                  drawing.Text = entry.name:sub(1, 40) .. "  |  " .. math.floor(distance + 0.5) .. " studs"
                  entry.nextText = now + 0.25
              end
              drawing.Position = Vector2.new(point.X, point.Y - 10)
              drawing.Visible = true
          end)
          if not ok and drawing then drawing.Visible = false end
      end
  end

  local function activeShakeButton()
      local cache = totemMenu.buttonCache
      local now = tick()
      if now < cache.shakeAt then return cache.shake end
      cache.shakeAt = now + 0.15
      local currentGui = player:FindFirstChildOfClass("PlayerGui")
      local shakeGui = currentGui and currentGui:FindFirstChild("shakeui")
      if not shakeGui then cache.shake = nil; return nil end
      local found
      for _, object in ipairs(shakeGui:GetDescendants()) do
          local class = object.ClassName
          if class == "GuiButton" or class == "TextButton"
              or class == "ImageButton" or class == "TextLabel" then
              local okText, text = pcall(function() return object.Text end)
              if okText and type(text) == "string"
                  and text:lower():find("shake", 1, true) then
                  local visible, node = true, object
                  while node and node ~= shakeGui do
                      local okVisible, value = pcall(function() return node.Visible end)
                      if okVisible and value == false then
                          visible = false
                          break
                      end
                      node = node.Parent
                  end
                  if visible then
                      node = object
                      while node and node ~= shakeGui do
                          local nodeClass = node.ClassName
                          if nodeClass == "GuiButton" or nodeClass == "TextButton"
                              or nodeClass == "ImageButton" then
                              found = node
                              break
                          end
                          node = node.Parent
                      end
                      if not found and (class == "GuiButton"
                          or class == "TextButton" or class == "ImageButton") then
                          found = object
                      end
                  end
              end
          end
          if found then break end
      end
      cache.shake = found
      return found
  end

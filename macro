local function runAutoTotem()
    if autoTotem.busy or not autoTotem.enabled then return end
    local kind,name=detectSlot9()
    autoTotem.targetKind,autoTotem.targetName=kind,name
    if not kind or kind=="unsupported" then
        autoTotem.pending=false
        setTotemStatus(name and ("Unsupported slot 9 item: "..name)
            or "Place a Luck, Tropical Sun, or Rainbow Totem in slot 9.")
        return
    end
    if scanTargetEvent(kind,true) then
        autoTotem.startupConfirmed=true
        autoTotem.startupCheckPending=false
        autoTotem.attemptStartedAt=nil
        autoTotem.pending=false
        autoTotem.nextScan=tick()+autoTotem.scanInterval
        setTotemStatus(name.." event is active; fishing can continue.")
        return
    end
    autoTotem.attemptStartedAt=autoTotem.attemptStartedAt or tick()
    if totemCheckFailsafe() then return end
    autoTotem.busy=true
    autoTotem.pending=false
    local generation=autoTotem.generation
    setMacroMouse(false)
    resetMacroTracking()
    setTotemStatus("Preparing "..name.."...")
    task.wait(.15)
    if not totemReady(generation) then return end
    local _,isDay=serverClock()
    if isDay==nil then
        totemFinish("Server time unavailable; retrying in 60s.",false,generation)
        return
    end
    local needsDay=kind=="tropical" or kind=="rainbow"
    if isDay~=needsDay then
        if scanTargetEvent(kind,true) then
            totemFinish(name.." event is active; fishing can continue.",true,generation)
            return
        end
        setTotemStatus((needsDay and "Using Sundial for daytime..."
            or "Using Sundial for nighttime..."))
        if not totemTapSlot(0x38,generation) or not totemClick(generation) then
            if totemReady(generation) then totemFinish("Stopped before Sundial completed.",false,generation) end
            return
        end
        setTotemStatus("Waiting for the Sundial time change...")
        local found,reason=totemWaitForEvent(kind,autoTotem.eventWaitSeconds,generation)
        if found then
            totemFinish(name.." event appeared; fishing can continue.",true,generation)
            return
        elseif reason=="stopped" or reason=="failsafe" then
            if reason=="stopped" then totemFinish("Stopped.",false,generation) end
            return
        end
        local _,dayAfter=serverClock()
        if dayAfter==nil then
            totemFinish("Server time unavailable; retrying in 60s.",false,generation)
            return
        end
        if dayAfter~=needsDay then
            totemFinish("Sundial did not change time; retrying in 60s.",false,generation)
            return
        end
        if scanTargetEvent(kind,true) then
            totemFinish(name.." event appeared after Sundial; fishing can continue.",true,generation)
            return
        end
    end
    setTotemStatus("Using "..name.." from slot 9...")
    if not totemTapSlot(0x39,generation) or not totemClick(generation) then
        if totemReady(generation) then totemFinish("Stopped before totem placement completed.",false,generation) end
        return
    end
    setTotemStatus("Checking for "..name.." event...")
    local found,reason=totemWaitForEvent(kind,autoTotem.eventWaitSeconds,generation)
    if found then
        totemFinish(name.." confirmed; fishing can continue.",true,generation)
        return
    elseif reason=="stopped" or reason=="failsafe" then
        if reason=="stopped" then totemFinish("Stopped.",false,generation) end
        return
    end
    setTotemStatus("Not detected; clicking "..name.." once more...")
    if not totemClick(generation) then
        if totemReady(generation) then totemFinish("Stopped.",false,generation) end
        return
    end
    found,reason=totemWaitForEvent(kind,autoTotem.eventWaitSeconds,generation)
    if found then
        totemFinish(name.." confirmed; fishing can continue.",true,generation)
    elseif reason=="stopped" or reason=="failsafe" then
        if reason=="stopped" then totemFinish("Stopped.",false,generation) end
    else
        totemFinish(name.." not detected; retrying in 60s.",false,generation)
    end
end
autoTotemPoll=function()
    if not autoTotem.enabled or autoTotem.busy then return end
    local focused=true
    if type(focusFn)=="function" then
        local ok,value=pcall(focusFn)
        focused=ok and value==true
    end
    if not focused then return end

        if not alive then break end
        if ok then
            cachedEvents=result
            footer.Text="P hide/show"
        else
            footer.Text="Scan unavailable; retrying..."
            warn("Fisch Weather scan: "..tostring(result))
        end
        task.wait(ENVIRONMENT_INTERVAL)
    end
end)

            local color=Color3.fromRGB(120+135*pulse,35,120+135*pulse)
            border.Color,accent.Color=color,color
            for _,e in ipairs(layout) do
                e.d.Transparency=e.opacity*alpha
                e.d.Visible=alpha>0.001
            end
            task.wait(shown and 1/30 or 0.05)
        end
    end)
    if not ok then stop();warn("Fisch Weather stopped: "..tostring(err)) end
end)

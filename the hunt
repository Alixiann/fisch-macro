if _G.BuildermanBadgeCleanup then pcall(_G.BuildermanBadgeCleanup) end
if _G.BuildermanESPStop then pcall(_G.BuildermanESPStop) end

local RunService = game:GetService("RunService")
local folder = game.Workspace.Gimmicks.Island1.Island1BadgeSpawn
local parts = folder:GetChildren()
local esp = {}
local alive = true

for i = 1, #parts do
    local box = Drawing.new("Square")
    box.Size = Vector2.new(18, 18)
    box.Color = Color3.fromRGB(255, 210, 40)
    box.Thickness = 2
    box.Filled = false
    box.Visible = false
    box.ZIndex = 10

    local text = Drawing.new("Text")
    text.Text = "Badge " .. i
    text.Size = 15
    text.Color = Color3.fromRGB(255, 235, 80)
    text.Outline = true
    text.Center = true
    text.Visible = false
    text.ZIndex = 11

    esp[i] = {part = parts[i], box = box, text = text}
end

local conn
conn = RunService.RenderStepped:Connect(function()
    if not alive then return end

    for i = 1, #esp do
        local e = esp[i]
        local screen, visible = WorldToScreen(e.part.Position + Vector3.new(0, 2, 0))

        if visible then
            e.box.Position = Vector2.new(screen.X - 9, screen.Y - 9)
            e.box.Visible = true
            e.text.Position = Vector2.new(screen.X, screen.Y - 27)
            e.text.Visible = true
        else
            e.box.Visible = false
            e.text.Visible = false
        end
    end
end)

local function stop()
    alive = false
    if conn then conn:Disconnect() end
    _G.BuildermanESPStop = nil
    for i = 1, #esp do
        pcall(function() esp[i].box:Remove() end)
        pcall(function() esp[i].text:Remove() end)
    end
end

_G.BuildermanESPStop = stop
print("Builderman badge ESP loaded for " .. #parts .. " locations")


if _G.BuildermanBadgeCleanup then pcall(_G.BuildermanBadgeCleanup) end

local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local mouse = lp:GetMouse()
local points = {
 Vector3.new(96.5,2.5,362.5), Vector3.new(124,48.9,422),
 Vector3.new(13.5,2.9,182.3), Vector3.new(38,18.5,234),
 Vector3.new(23,39.8,321), Vector3.new(-26.5,37.5,175.5),
 Vector3.new(-69.5,23.5,307.5), Vector3.new(-117.5,31.5,281),
 Vector3.new(-103,42.1,343), Vector3.new(-117.5,31.5,181.5)
}
local draw, rows = {}, {}
local alive, x0, y0, pw, ph = true, 24, 150, 250, 350

local function addRect(x,y,w,h,c,z)
 local d=Drawing.new("Square"); d.Position=Vector2.new(x,y); d.Size=Vector2.new(w,h)
 d.Color=c; d.Filled=true; d.Transparency=1; d.ZIndex=z or 1; draw[#draw+1]=d; return d
end

local function addText(t,x,y,s,c,center,z)
 local d=Drawing.new("Text"); d.Text=t; d.Position=Vector2.new(x,y); d.Size=s
 d.Color=c; d.Outline=true; d.Center=center or false; d.ZIndex=z or 3; draw[#draw+1]=d; return d
end

addRect(x0,y0,pw,ph,Color3.fromRGB(24,27,36),1)
addRect(x0,y0,pw,42,Color3.fromRGB(45,112,190),2)
addText("Builderman Badges",x0+12,y0+12,18,Color3.fromRGB(255,255,255),false,4)
local close=addRect(x0+pw-34,y0+9,24,24,Color3.fromRGB(180,55,65),3)
addText("X",x0+pw-22,y0+12,16,Color3.fromRGB(255,255,255),true,4)

for i=1,10 do
 local y=y0+42+(i-1)*28+5
 rows[i]={bg=addRect(x0+8,y,pw-16,24,Color3.fromRGB(48,53,66),2),y=y}
 addText("Badge "..i,x0+18,y+5,15,Color3.fromRGB(240,240,245),false,4)
end

addText("Click a badge to teleport",x0+10,y0+ph-22,12,Color3.fromRGB(175,185,200),false,4)

local function cleanup()
 alive=false
 _G.BuildermanBadgeCleanup=nil
 for i=1,#draw do pcall(function() draw[i]:Remove() end) end
end
_G.BuildermanBadgeCleanup=cleanup

local function teleport(i)
 local char=lp.Character
 local root=char and char:FindFirstChild("HumanoidRootPart")
 local p=points[i]
 if root and p then
  root.CFrame=CFrame.new(p.X,p.Y+4,p.Z)
  print("Teleported to Builderman badge "..i)
 end
end

task.spawn(function()
 local wasDown=false
 while alive do
  local mx,my=mouse.X,mouse.Y
  local down=ismouse1pressed()
  if mx>=x0+pw-34 and mx<=x0+pw-10 and my>=y0+9 and my<=y0+33 then
   close.Color=Color3.fromRGB(230,75,85)
   if down and not wasDown then cleanup() break end
  else close.Color=Color3.fromRGB(180,55,65) end
  for i=1,10 do
   local r=rows[i]
   local inside=mx>=x0+8 and mx<=x0+pw-8 and my>=r.y and my<=r.y+24
   r.bg.Color=inside and Color3.fromRGB(70,130,210) or Color3.fromRGB(48,53,66)
   if inside and down and not wasDown then teleport(i) end
  end
  wasDown=down
  task.wait(0.03)
 end
end)

print("Builderman badge GUI loaded")


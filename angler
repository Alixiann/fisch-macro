local function replaceUiOnce(old, new)
    local at = string.find(source, old, 1, true)
    assert(at, "Wabi Sabi tab layout changed")
    source = string.sub(source, 1, at - 1) .. new .. string.sub(source, at + #old)
end
replaceUiOnce("if cfg.TabWidth then RAIL_W = math.max(80, math.floor(cfg.TabWidth)) end",
    "if cfg.TabWidth then RAIL_W = math.max(0, math.floor(cfg.TabWidth)) end")
replaceUiOnce("for i, t in ipairs(Tabs) do\n        local ty = tabY0",
    "for i, t in ipairs(RAIL_W > 0 and Tabs or {}) do\n        local ty = tabY0")
replaceUiOnce("local hdrH = 38", "local hdrH = RAIL_W > 0 and 38 or 0")
replaceUiOnce("text(\"win.tabhdr\", tab.name, cx + 2, cvy + 4, 28, Theme.Text, 42)",
    "if RAIL_W > 0 then text(\"win.tabhdr\", tab.name, cx + 2, cvy + 4, 28, Theme.Text, 42) end")
replaceUiOnce("rect(\"tab.ind\", win.x + 8, tabY0 + State.IndOff.v + 7 + (16 - ih) / 2, 3, ih, Theme.Accent, 1, 61, 2)",
    "if RAIL_W > 0 then rect(\"tab.ind\", win.x + 8, tabY0 + State.IndOff.v + 7 + (16 - ih) / 2, 3, ih, Theme.Accent, 1, 61, 2) end")

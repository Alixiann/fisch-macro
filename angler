local state = {running=true, ui=ui}
state.status = function() return statusText end
state.isEnabled = function() return enabled end
state.setEnabled = function(value)
    enabled = value == true
    if autoToggle then pcall(function() autoToggle:SetValue(enabled) end) end
    setStatus(enabled and ("On - checking Angler at " .. selected.name) or "Off")
end
_G.AutoAnglerState = state
local uis = game:GetService("UserInputService")
local lastF4Toggle = 0
local lastF7Calibration = 0
local lastF6Calibration = 0
local function calibrateDialogueFromKey()
    if tick() - lastF6Calibration < .35 then return end
    lastF6Calibration = tick()
    lastHotkey = "F6"
    refreshCalibrationStatus()
    task.spawn(calibrateDialogue)
end
local function calibrateSearchFromKey()
    if tick() - lastF7Calibration < .35 then return end
    lastF7Calibration = tick()
    lastHotkey = "F7"
    refreshCalibrationStatus()
    calibrateSearch()
end
local function toggleFromF4()
    if tick() - lastF4Toggle < .35 then return end
    lastF4Toggle = tick()
    lastHotkey = "F4"
    refreshCalibrationStatus()
    local nextValue = not enabled
    enabled = nextValue
    if autoToggle then pcall(function() autoToggle:SetValue(nextValue) end) end
    setStatus(nextValue and ("On - checking Angler at " .. selected.name) or "Off")
end
local inputHandle = uis.InputBegan:Connect(function(input)
    local keyCode = input and input.KeyCode
    if keyCode == Enum.KeyCode.F4.Value then toggleFromF4() end
    if keyCode == Enum.KeyCode.F6.Value then calibrateDialogueFromKey() end
    if keyCode == Enum.KeyCode.F7.Value then calibrateSearchFromKey() end
end)

task.spawn(function()
    local wasDown = false
    while state.running do
        local ok, pressed = pcall(iskeypressed, 0x76) -- Windows F7
        local down = ok and pressed == true
        if down and not wasDown then calibrateSearchFromKey() end
        wasDown = down
        task.wait(.05)
    end
end)

-- Poll Roblox F-key state as a fallback when InputBegan is consumed.
task.spawn(function()
    local wasDown = false
    while state.running do
        local ok, pressed = pcall(iskeypressed, 0x73) -- Windows F4
        local down = ok and pressed == true
        if down and not wasDown then toggleFromF4() end
        wasDown = down
        task.wait(.05)
    end
end)

task.spawn(function()
    local wasDown = false
    while state.running do
        local ok, pressed = pcall(iskeypressed, 0x75) -- Windows F6
        local down = ok and pressed == true
        if down and not wasDown then calibrateDialogueFromKey() end
        wasDown = down
        task.wait(.05)
    end
end)

state.stop = function()
    enabled = false
    state.running = false
    pcall(function() inputHandle:Disconnect() end)
    setStatus("Stopped")
    pcall(function() ui:Stop() end)
end

-- Main loop stays responsive to the UI toggle and F4 stop/start key.
task.spawn(function()
    state.loopCount = 0
    while state.running do
        state.loopCount = state.loopCount + 1
        if enabled then
            local ok, err = pcall(runOneQuest)
            if not ok then setStatus("Error: " .. tostring(err)); warn("Auto Angler: " .. tostring(err)) end
            task.wait(.5)
        else
            task.wait(.15)
        end
    end
end)

